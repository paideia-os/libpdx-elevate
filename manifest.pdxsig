# manifest.pdxsig — libpdx-elevate v1.1.0
#
# Dual-signed release manifest per D4 (design/tooling/plan.md §6).  Two
# ML-DSA-65 signatures cover the manifest body: (a) the author key of the
# repository owner, and (b) the Paideia root key that re-signs at the
# `pkgs.paideia-os` mirror gate.
#
# This text form is the canonical source of truth for the manifest body.
# `paideia-as release --sign`, once v0.33-crypto-kdf is reachable through
# the toolchain, canonicalises this file (strip comments, sort keys,
# LF-only, no trailing whitespace) into the byte string that both
# signatures cover, then rewrites the two SIG-BYTES blocks below with the
# 3309-byte ML-DSA-65 outputs.  Until then the SIG-BYTES blocks carry the
# stub marker below; the manifest body itself is stable and any tool
# that resigns against v0.33-crypto will produce a message digest
# identical to the one recorded here.
#
# ---
#
# v1.1.0 (2026-09-11) — first signed release since v1.0.0 (2026-08-22).
# This tag subsumes the two retired unsigned landing markers v1.1.1 and
# v1.1.2 (annotated-but-unsigned per `.plans/mirror-push.md`'s landing-
# marker convention) plus the LE.M4-M7 landings that arrived on `main`
# between 2026-09-02 and 2026-09-11.  See CHANGELOG.md's `[1.1.0]`
# section for the full wave/issue breakdown and the STATUS.md M6
# close-out section for release-artefact status.

[manifest]
schema-version        = 1
tool-name             = libpdx-elevate
tool-kind             = shared-library
version               = 1.1.0
released              = 2026-09-11
source-repo           = https://github.com/paideia-os/libpdx-elevate
source-commit         = 6d74d970b706e663ef40fe3192a706a4240e11e8
source-tree-hash-sha256 = eb25f2f4d84bda651b2c0472878b0f360bf1978a69d948fe4874134c454f9042
license               = MIT
supersedes            = 1.0.0
subsumes-markers      = v1.1.1, v1.1.2   # retired unsigned landing tags

# source-tree-hash-sha256 canonicalisation: sha256 over the byte string
# produced by `sha256sum <path>` lines for every `.pdx` file under `src/`
# and `tests/`, sorted lexicographically by path (LF line endings, one
# entry per line, `<sha256-hex>  <path>\n`).  A per-file table follows
# under `[artifacts]` so an auditor can re-verify without recomputing
# the tree hash inline.

[artifacts]
