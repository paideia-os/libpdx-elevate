[entry-points]
# Every public callable this v1.1.0 signed manifest covers.  The
# `caps.decl` file below stanzas each of these with its floor cap set;
# the manifest hash of `caps.decl` (see [cap-manifest]) is the
# canonical binding.  Listed here so a mirror-side tool auditing "does
# my consumer request a v1.1.0-known entry point?" does not have to
# parse the `caps.decl` DSL.
#
# --- v1.0.0 carryover (M1-M5) ---
elevate_client_lookup_broker        = src/elevate_client.pdx
elevate_client_send_req             = src/elevate_client_send.pdx
elevate_client_recv_reply           = src/elevate_client_send.pdx
elevate_client_check_grant          = src/elevate_client_send.pdx
elevate_client_request_ex           = src/elevate_client_send.pdx
elevate_client_request_ex_j         = src/elevate_client_journal.pdx
elevate_client_request_ex_r         = src/elevate_client_retry.pdx
elevate_client_journal_req          = src/elevate_client_journal.pdx
elevate_client_journal_apr          = src/elevate_client_journal.pdx
elevate_client_cap_mint             = src/elevate_client_cap.pdx
elevate_client_cap_bind_expire      = src/elevate_client_cap.pdx
elevate_client_cap_expired          = src/elevate_client_cap.pdx
elevate_client_cap_check_and_revoke = src/elevate_client_cap.pdx
elevate_client_cap_narrow_stub      = src/elevate_client_cap.pdx
# --- ENH-005 rename (source-breaking) ---
elevate_client_request_norealize    = src/elevate_client.pdx        # was elevate_client_request
# --- ENH-001..004: credential-shaped surface ---
elevate_client_acquire              = src/elevate_client_acquire.pdx
elevate_client_require              = src/elevate_client_require.pdx
elevate_client_require_j            = src/elevate_client_require.pdx
elevate_client_require_scoped       = src/elevate_client_require.pdx
elevate_client_journal_op           = src/elevate_client_journal.pdx
elevate_client_cap_bind_expire_abs  = src/elevate_client_cap.pdx
elevate_client_cap_bind_grant       = src/elevate_client_cap.pdx
elevate_client_cap_get_grant        = src/elevate_client_cap.pdx
elevate_client_cap_bind_scope       = src/elevate_client_cap.pdx
elevate_client_cap_get_scope        = src/elevate_client_cap.pdx
elevate_client_cap_bind_budget      = src/elevate_client_cap.pdx
elevate_client_cap_get_budget_remaining = src/elevate_client_cap.pdx
elevate_client_cap_consume_budget   = src/elevate_client_cap.pdx
# --- ENH-006 + LE.M1-002: explicit-context (ctx) surface ---
elevate_client_request_ex_ctx       = src/elevate_client_send.pdx
elevate_client_request_ex_j_ctx     = src/elevate_client_journal.pdx
elevate_client_request_ex_r_ctx     = src/elevate_client_retry.pdx
elevate_client_acquire_ctx          = src/elevate_client_acquire.pdx
# --- R90-XREPO.011.M1-006: outcome reduction ---
elevate_client_classify_outcome     = src/elevate_client_outcome.pdx
elevate_client_request_outcome      = src/elevate_client_outcome.pdx
# --- LE.M3-001/002/003: multilevel-chain foundations ---
elevate_client_cap_derive           = src/elevate_client_cap.pdx
elevate_client_cap_bind_parent      = src/elevate_client_cap.pdx
elevate_client_cap_get_parent       = src/elevate_client_cap.pdx
elevate_client_cap_get_depth        = src/elevate_client_cap.pdx
# --- LE.M4-001: per-cap-mask duration ceilings ---
elevate_request_duration_valid_for  = src/elevate_request.pdx
# --- LE.M4-002: idle-time reap + optional teardown helper ---
elevate_client_cap_reap_expired     = src/elevate_client_cap.pdx
elevate_client_shutdown             = src/elevate_client_cap.pdx
elevate_client_journal_reap         = src/elevate_client_journal.pdx
# --- LE.M5-001/002: attestation ---
elevate_client_cap_attest           = src/elevate_client_cap.pdx
elevate_client_cap_bind_attestation_required = src/elevate_client_cap.pdx
elevate_client_cap_get_attestation_required  = src/elevate_client_cap.pdx
elevate_client_cap_bind_last_audit  = src/elevate_client_cap.pdx
elevate_client_cap_get_last_audit_seq  = src/elevate_client_cap.pdx
elevate_client_cap_get_last_audit_kind = src/elevate_client_cap.pdx
# --- LE.M6-001: file-sink STUB (fail-CLOSED) ---
# _elevate_client_audit_file_append is private-by-convention (leading
# underscore) and is NOT re-exported as an entry point.  Its four call
# sites (_journal_req/_apr/_op + _cap_attest) already appear above.
# --- LE.M7-001/002 + #53: revoke cascade + broker-triggered propagation + cascade-abort marker ---
elevate_client_cap_revoke_cascade      = src/elevate_client_cap.pdx
elevate_client_cap_drain_broker_exp    = src/elevate_client_send.pdx
elevate_client_journal_revoke_cascade  = src/elevate_client_journal.pdx
elevate_client_journal_cascade_abort   = src/elevate_client_journal.pdx

[cap-manifest]
# Hash over caps.decl.  The raw-file hash below is authoritative for
# v1.1.0 — the file has LF-only line endings and no trailing
# whitespace, so the canonical form (per canonicalise-manifest.sh,
# landing in paideia-as v0.33) equals the raw file byte-for-byte.
# A canonicalisation-form field is kept below for the release-sign
# tool to verify at push time.
caps.decl.file       = caps.decl
caps.decl.sha256     = sha256:36456bd533b7b88f1ee74507468e4ea732ebc728ce3798cca1e1c3ef65fbc276
caps.decl.canonical  = sha256:36456bd533b7b88f1ee74507468e4ea732ebc728ce3798cca1e1c3ef65fbc276

[deps]
deps.list.file       = deps.list
deps.list.sha256     = sha256:cf74808c928e3532ccb3c40b39e21c57fa5fbabeb1ab9037b91019ed40ce5a92
deps.list.canonical  = sha256:cf74808c928e3532ccb3c40b39e21c57fa5fbabeb1ab9037b91019ed40ce5a92
# Both PENDING lines stay PENDING at v1.1.0:
#   - libpdx-cap  >=0.2.0  (LE.M2-001 swap site, cap_narrow_rights)
#   - libpdx-audit >=1.1.2 (LE.M2-002 swap site, audit_begin/output/commit
#                           trio) + libpdx-audit >=1.2.0 (LE.M6-001 swap
#                           site, audit_file_append via libpdx-audit#32).
# Flipping either is a v1.1.x follow-up, not a v1.1.0 blocker.

[changelog]
CHANGELOG.md.sha256  = sha256:55dc83ffe53b58296bbafbc5ac7e0a9e7519a7317c2f4b54ab144cccf6f9e54b

[docs]
doc/libpdx-elevate.pdxdoc.sha256 = sha256:25558b5b75ee30be5bb26819964b4839a82ab4ccba07e63a2f975d5bd99a5b5a

[kernel-substrate]
# The paideia-os kernel primitives libpdx-elevate v1.1.0 links against.
# Substrate change bumps require re-signing (major or minor per SemVer);
# see CHANGELOG.md §"Known deferred paths" for the swap sites.
paideia-os-issue-1626   = KIND_ELEVATE_CHANNEL = 0x191
paideia-os-issue-1627   = svc.elevate-broker registration + policy wiring
paideia-os-issue-1549   = elevate wire codec (elv_pack_req)
paideia-os-issue-1550   = elevate policy table (ep_check, ep_hit_row)
paideia-os-issue-1544   = user_events_journal (uej_append, UEJ_KIND_ELEVATE=5)
# --- Additional substrate landed post-v1.0.0 and consumed at v1.1.0 ---
paideia-os-issue-2117   = sched_wait (retires the elevate_client_retry_delay busy-poll)
paideia-os-issue-2118   = elevate_channel_row_set_expire (row [+32] slot)
paideia-os-issue-2119   = /system/policy on-disk format + seed
paideia-os-issue-2121   = fail-closed policy directive
paideia-os-issue-2122   = broker daemon dispatch body (elevate_broker consumes REQ, emits APR)
paideia-as-toolchain    = >=v0.33-crypto-kdf (for release --sign)

[signature.author]
key-fingerprint       = <author_pk-fingerprint-pending-v0.33-crypto>
key-owner             = paideia-os (santiago; snunezcr@gmail.com)
algorithm             = ML-DSA-65
signed-at             = <populated-at-release-sign-time>
sig-bytes             = <MLDSA65-SIG:STUB-PENDING-V0.33-CRYPTO-KDF>
# The stub marker above is a fixed 42-byte ASCII sentinel that
# `paideia-as release --sign` scans for and replaces in place with the
# 3309-byte ML-DSA-65 signature (base64-encoded, 4412 chars) once the
# crypto tag is reachable.  The manifest body preceding this section is
# hash-stable, so signing produces a bit-identical output on any
# machine holding the author key.

[signature.paideia-root]
key-fingerprint       = <paideia_root_pk-fingerprint-per-R32>
key-owner             = pkgs.paideia-os re-sign gate
algorithm             = ML-DSA-65
signed-at             = <populated-at-mirror-push-time>
sig-bytes             = <MLDSA65-SIG:STUB-PENDING-V0.33-CRYPTO-KDF>
# Applied by the Paideia signing bot at the pkgs.paideia-os/main/
# staging gate (design/tooling/plan.md §8, release-flow step 4):
# the bot verifies the author sig, computes its own signature over the
# identical canonical body, and rewrites this second SIG-BYTES field.
# Both must verify for `pkg install libpdx-elevate` to accept the
# manifest (§6.2 trust model — dual signature).
