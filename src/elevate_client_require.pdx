// src/elevate_client_require.pdx -- libpdx-elevate.ENH-002 (paideia-os/libpdx-elevate#13)
//
// elevate_client_require -- per-op re-assert against a handle, no broker hop.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// The other half of ENH-001's structural fix. elevate_client_acquire
// (elevate_client_acquire.pdx) hands back a row_id HANDLE; this file
// is what a caller re-checks BEFORE each individual mutating step of
// a multi-step operation (a recursive delete's per-file pass, a
// package install's per-file write) so a handle obtained once cannot
// be silently reused past its deadline or beyond what it was actually
// granted.
//
// The re-assert is DELIBERATELY cheap: no broker round-trip, no IPC.
// It is exactly two local checks:
//
//   (a) not expired      -- via elevate_client_cap_check_and_revoke,
//                            which also fires the kernel-side revoke
//                            the instant the deadline is found to have
//                            passed (self-invalidation, M2-003).
//   (b) caps still cover  -- (needed_caps & granted_caps) == needed_caps,
//       this op            reading the shadow grant map ENH-001 bound
//                          at acquire time (elevate_client_cap_
//                          bind_grant).
//
// "A recursive walk calls it once per item; the cost is a clock read"
// (enhancement-plan.md §3) -- check_and_revoke's own cost is exactly
// one hpet_now_ns() sample on the live-row path; the caps check below
// it is a bitwise AND against an already-resident cache line.
//
// A row never bound via elevate_client_acquire (i.e. minted directly
// via elevate_client_cap_mint, bypassing bind_grant) has granted_caps
// == 0 in the shadow map; elevate_client_require refuses such a row
// with ELCA_ERR_NO_GRANT rather than treating an empty mask as "covers
// nothing requested" (which would vacuously pass a needed_caps == 0
// call) or "covers everything" (which would be the actual security
// bug this file exists to prevent). Row 0 in the shadow map genuinely
// meaning "never bound" is exactly the ELCC_ERR_NO_GRANT convention
// elevate_client_cap_bind_grant / _get_grant already establish.
//
// ENH-004 (#16) adds elevate_client_require_j, an audit-wrapped
// variant that journals ONE per-op record (via elevate_client_
// journal_op, elevate_client_journal.pdx) for every AUTHORIZED use --
// see that function's doc below for why a refusal is not journaled.
// The count of those records against one REQ/APR pair is the grant-
// amplification signal the enhancement plan calls for.
//
// =============================================================================
// ERROR BAND 0xFFFFEA60..0xFFFFEA6F
// =============================================================================
//
//   0xFFFFEA60  ELCA_ERR_EXPIRED             -- handle's deadline has
//                                                passed (the kernel
//                                                revoke has already
//                                                fired or just did)
//   0xFFFFEA61  ELCA_ERR_CAPS_INSUFFICIENT   -- needed_caps is not a
//                                                subset of what this
//                                                handle was granted
//   0xFFFFEA62  ELCA_ERR_SCOPE_MISMATCH      -- ENH-003 (#15): the
//                                                handle has a bound
//                                                scope (elevate_client_
//                                                cap_bind_scope) and the
//                                                caller's scope_fp does
//                                                not match it
//
// ELCC_ERR_BAD_ROW / ELCC_ERR_NO_DEADLINE / ELCC_ERR_NO_GRANT
// (elevate_client_cap.pdx, 0xFFFFEA30 band) pass through unchanged
// when the underlying shadow-map lookups refuse for those reasons --
// they are caller-side usage errors (bad row_id, or a row that was
// never bound through the acquire path), not per-op refusals, so they
// keep their own band rather than being re-wrapped here.

module ElevateClientRequire = structure {

  pub let ELCA_OK                    : u64 = 0
  pub let ELCA_ERR_EXPIRED           : u64 = 0xFFFFEA60
  pub let ELCA_ERR_CAPS_INSUFFICIENT : u64 = 0xFFFFEA61
  pub let ELCA_ERR_SCOPE_MISMATCH    : u64 = 0xFFFFEA62

  // ---- Stats ----
  //
  //   0 checks       every elevate_client_require call
  //   1 live_ok      passed both the freshness and caps checks
  //   2 expired      refused: check_and_revoke reported the row gone
  //   3 insufficient refused: needed_caps not covered by the grant
  //   4..7 reserved

  pub let mut _elevate_client_require_stats : [u64; 8] = uninit @align(64)

  pub let ELCA_ST_CHECKS           : u64 = 0
  pub let ELCA_ST_LIVE_OK          : u64 = 1
  pub let ELCA_ST_EXPIRED          : u64 = 2
  pub let ELCA_ST_INSUFFICIENT     : u64 = 3
  pub let ELCA_ST_SCOPE_MISMATCH   : u64 = 4  // ENH-003 (#15)
  pub let ELCA_ST_BUDGET_EXHAUSTED : u64 = 5  // ENH-003 (#15)
  pub let ELCA_ST_MAX              : u64 = 8

  // ==========================================================================
  // elevate_client_require_reset() -> ()
  //
  // Scrub the stats table. Boot / teardown only. Same shape as every
  // other *_reset in this library.
  // ==========================================================================

  pub let elevate_client_require_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-elevate.ENH-002 (#13): clear the 8-slot require stats table. Boot / teardown discipline; a live counter reset would race a concurrent elevate_client_require call. Leaf. Labels prefixed elcq_rs_.",
      block: {
        lea r10, [rip + _elevate_client_require_stats];
        xor rax, rax;
        xor rcx, rcx;
      elcq_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  elcq_rs_loop;
        ret
      }
    }

  pub let elevate_client_require_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-elevate.ENH-002 (#13): bounded increment; out-of-range which is a no-op. Same shape as elevate_client_note. Labels prefixed elcq_nt_.",
      block: {
        cmp rdi, 8;
        jae elcq_nt_out;
        lea r10, [rip + _elevate_client_require_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      elcq_nt_out:
        ret
      }
    }

  pub let elevate_client_require_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-elevate.ENH-002 (#13): bounded read; out-of-range returns 0. Same convention as elevate_client_stat. Labels prefixed elcq_st_.",
      block: {
        cmp rdi, 8;
        jae elcq_st_zero;
        lea r10, [rip + _elevate_client_require_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      elcq_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // elevate_client_require(row_id, needed_caps)
  //   -> ELCA_OK | ELCA_ERR_EXPIRED | ELCA_ERR_CAPS_INSUFFICIENT
  //      | ELCC_ERR_BAD_ROW | ELCC_ERR_NO_DEADLINE | ELCC_ERR_NO_GRANT
  //
  // The per-op re-assert. No broker hop -- see the file header.
  //
  // Sequence:
  //   (1) elevate_client_cap_check_and_revoke(row_id):
  //         ELCC_STATE_LIVE    -> continue to the caps check
  //         ELCC_STATE_REVOKED -> ELCA_ERR_EXPIRED (deadline passed;
  //                               kernel revoke fired just now or
  //                               earlier -- either way the handle is
  //                               gone)
  //         ELCC_ERR_BAD_ROW / ELCC_ERR_NO_DEADLINE -> passthrough
  //           (caller-side usage error: bad row_id, or a row that was
  //           never bound via elevate_client_cap_bind_expire /
  //           elevate_client_acquire)
  //   (2) elevate_client_cap_get_grant(row_id) -> granted_caps.
  //       granted_caps == 0 -> ELCC_ERR_NO_GRANT (never bound via
  //       elevate_client_acquire / elevate_client_cap_bind_grant).
  //   (3) (needed_caps & granted_caps) == needed_caps -> ELCA_OK,
  //       else ELCA_ERR_CAPS_INSUFFICIENT.
  //
  // Register plan: r12=row_id, r13=needed_caps. Two callee-save
  // pushes + one 8-byte alignment pad = 24 bytes; entry rsp%16==8 ->
  // (8-24) mod 16 == 0 so the nested calls (check_and_revoke,
  // get_grant, note) see aligned rsp.
  // ==========================================================================

  pub let elevate_client_require : (u64, u64) -> u64 !{mem} @{cap, boot} =
    fn (row_id: u64) (needed_caps: u64) -> unsafe {
      effects: {mem}, capabilities: {cap, boot},
      justification: "libpdx-elevate.ENH-002 (#13): the per-op re-assert -- freshness (via elevate_client_cap_check_and_revoke, which itself needs {cap, boot} for the kernel revoke + hpet_now_ns chain) then caps-subset against the shadow grant map (elevate_client_cap_get_grant). Two callee-save pushes (r12=row_id, r13=needed_caps) + one 8-byte alignment pad = 24 bytes; entry rsp%16==8 -> (8-24) mod 16 == 0 so every nested call sees aligned rsp. Every call bumps ELCA_ST_CHECKS up front so a caller's stats read reflects attempted checks even on an early passthrough refusal. ELCC_ERR_BAD_ROW / ELCC_ERR_NO_DEADLINE / ELCC_ERR_NO_GRANT are NOT re-wrapped -- they identify a caller-side usage error (bad row_id, or a row never bound through the acquire path) distinct from a per-op refusal, so they keep their own 0xFFFFEA3* band. Labels prefixed elcq_rq_.",
      block: {
        push r12;
        push r13;
        sub rsp, 8;                      // alignment

        mov r12, rdi;                    // row_id
        mov r13, rsi;                    // needed_caps

        mov rdi, 0;                      // ELCA_ST_CHECKS
        call elevate_client_require_note;

        // (1) Freshness.
        mov rdi, r12;
        call elevate_client_cap_check_and_revoke;
        mov r10, 0xFFFFEA34;             // ELCC_STATE_LIVE
        cmp rax, r10;
        je  elcq_rq_fresh;
        mov r10, 0xFFFFEA36;             // ELCC_STATE_REVOKED
        cmp rax, r10;
        je  elcq_rq_expired;
        // ELCC_ERR_BAD_ROW / ELCC_ERR_NO_DEADLINE -- passthrough as-is.
        add rsp, 8;
        pop r13;
        pop r12;
        ret;

      elcq_rq_fresh:
        // (2) Read the shadow grant.
        mov rdi, r12;
        call elevate_client_cap_get_grant;
        cmp rax, 0;
        je  elcq_rq_no_grant;

        // (3) Subset check: (needed & granted) == needed.
        mov r10, rax;                    // granted_caps
        mov rax, r13;                    // needed_caps
        and rax, r10;
        cmp rax, r13;
        jne elcq_rq_insufficient;

        mov rdi, 1;                      // ELCA_ST_LIVE_OK
        call elevate_client_require_note;
        xor rax, rax;                    // ELCA_OK
        add rsp, 8;
        pop r13;
        pop r12;
        ret;

      elcq_rq_expired:
        mov rdi, 2;                      // ELCA_ST_EXPIRED
        call elevate_client_require_note;
        mov rax, 0xFFFFEA60;             // ELCA_ERR_EXPIRED
        add rsp, 8;
        pop r13;
        pop r12;
        ret;

      elcq_rq_insufficient:
        mov rdi, 3;                      // ELCA_ST_INSUFFICIENT
        call elevate_client_require_note;
        mov rax, 0xFFFFEA61;             // ELCA_ERR_CAPS_INSUFFICIENT
        add rsp, 8;
        pop r13;
        pop r12;
        ret;

      elcq_rq_no_grant:
        mov rax, 0xFFFFEA38;             // ELCC_ERR_NO_GRANT (passthrough band)
        add rsp, 8;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // elevate_client_require_j(actor_fp_lo, row_id, needed_caps)
  //   -> ELCA_OK | ELCA_ERR_* | ELCC_ERR_* | ELVJ_ERR_*
  //
  // ENH-004 (#16).  Audit-wrapped per-op re-assert: elevate_client_
  // require, then -- ONLY on ELCA_OK -- elevate_client_journal_op
  // (elevate_client_journal.pdx). A refused check is NOT journaled
  // here (see elevate_client_journal_op's doc for why); a caller
  // wanting an audit trail of attempted-but-refused ops reads
  // elevate_client_require_stat directly.
  //
  // ELVJ_ERR_OP_JOURNAL_FAIL on the journal step means the SAME thing
  // ELVJ_ERR_APR_JOURNAL_FAIL means at the acquire layer: the
  // operation was authorized (the caller's needed_caps really were
  // covered by a live handle) but the audit record recording that
  // fact did not land. Unlike a broken APR journal, there is no cap to
  // revoke here -- the handle itself is unaffected -- but the caller
  // should treat the returned non-zero code as "do not treat this op
  // as audit-covered" and escalate accordingly (e.g. retry the journal
  // write out of band, or abort the operation if audit coverage is a
  // hard requirement for this caller).
  //
  // Register plan: r12=row_id, r13=needed_caps, r14=actor_fp_lo. Three
  // callee-save pushes = 24 bytes; entry rsp%16==8 -> (8-24) mod 16 ==
  // 0, no pad needed (same shape as elevate_client_journal_req).
  // ==========================================================================

  pub let elevate_client_require_j : (u64, u64, u64) -> u64 !{mem} @{cap, boot} =
    fn (actor_fp_lo: u64) (row_id: u64) (needed_caps: u64) -> unsafe {
      effects: {mem}, capabilities: {cap, boot},
      justification: "libpdx-elevate.ENH-004 (#16): audit-wrapped per-op re-assert -- elevate_client_require then, only on success, elevate_client_journal_op. Three callee-save pushes (r12=row_id, r13=needed_caps, r14=actor_fp_lo) = 24 bytes; entry rsp%16==8 -> (8-24) mod 16 == 0, no pad needed, matching elevate_client_journal_req's shape. A refusal from elevate_client_require passes through unchanged with no journal attempt (see elevate_client_journal_op's doc for the rationale: journaling refusals would make the per-op write count meaningless as an amplification signal). capabilities {cap, boot} are the exact union of elevate_client_require's own {cap, boot} and elevate_client_journal_op's {} (mem only). Labels prefixed elcq_rj_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r14, rdi;                    // actor_fp_lo
        mov r12, rsi;                    // row_id
        mov r13, rdx;                    // needed_caps

        mov rdi, r12;                    // row_id
        mov rsi, r13;                    // needed_caps
        call elevate_client_require;
        cmp rax, 0;
        jne elcq_rj_out;                 // refusal passthrough -- not journaled

        mov rdi, r14;                    // actor_fp_lo
        mov rsi, r12;                    // row_id
        mov rdx, r13;                    // needed_caps
        call elevate_client_journal_op;
        cmp rax, 256;                    // ELVJ_UEJ_SEQ_MAX
        jb  elcq_rj_success;
        jmp elcq_rj_out;                 // ELVJ_ERR_* passthrough

      elcq_rj_success:
        xor rax, rax;                    // ELCA_OK

      elcq_rj_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // elevate_client_require_scoped(row_id, needed_caps, scope_fp)
  //   -> ELCA_OK | ELCA_ERR_EXPIRED | ELCA_ERR_CAPS_INSUFFICIENT
  //      | ELCA_ERR_SCOPE_MISMATCH | ELCC_ERR_BUDGET_EXHAUSTED
  //      | ELCC_ERR_BAD_ROW | ELCC_ERR_NO_DEADLINE | ELCC_ERR_NO_GRANT
  //
  // ENH-003 (#15). elevate_client_require plus the two structural
  // bindings a caller may have set on the handle via elevate_client_
  // cap_bind_scope / _bind_budget (elevate_client_cap.pdx): a scope
  // match and a budget consumption, exactly once per call, in that
  // order after the base freshness+caps check.
  //
  // Neither binding is required: an unscoped handle (scope never
  // bound, or bound as 0) matches any scope_fp; an unbudgeted handle
  // (budget never bound) never exhausts. A caller that never calls
  // bind_scope / bind_budget gets IDENTICAL behavior to plain
  // elevate_client_require -- this function is strictly additive.
  //
  // Sequence:
  //   (1) elevate_client_require(row_id, needed_caps) -- non-zero
  //       passes straight through (already the correct band).
  //   (2) elevate_client_cap_get_scope(row_id) -- if the returned
  //       scope is non-zero AND does not equal the caller's scope_fp,
  //       refuse ELCA_ERR_SCOPE_MISMATCH.
  //   (3) elevate_client_cap_consume_budget(row_id) -- ELCC_ERR_
  //       BUDGET_EXHAUSTED passes straight through (already the
  //       correct band; see that function's +1 storage-encoding note
  //       for why it can refuse every call past exhaustion rather than
  //       just the first).
  //   (4) ELCA_OK.
  //
  // Register plan: r12=row_id, r13=needed_caps, r14=scope_fp. Three
  // callee-save pushes = 24 bytes; entry rsp%16==8 -> (8-24) mod 16 ==
  // 0, no pad needed.
  // ==========================================================================

  pub let elevate_client_require_scoped : (u64, u64, u64) -> u64 !{mem} @{cap, boot} =
    fn (row_id: u64) (needed_caps: u64) (scope_fp: u64) -> unsafe {
      effects: {mem}, capabilities: {cap, boot},
      justification: "libpdx-elevate.ENH-003 (#15): elevate_client_require plus scope-match and budget-consume, both additive and both no-ops on a handle that never bound them (0 = unscoped / unbudgeted). Three callee-save pushes (r12=row_id, r13=needed_caps, r14=scope_fp) = 24 bytes; entry rsp%16==8 -> (8-24) mod 16 == 0, no pad needed, matching elevate_client_journal_req's shape. Step order (freshness+caps, then scope, then budget) matters only for which stat bumps first on a multi-reason refusal; a caller sees exactly one refusal code either way since each step returns immediately. capabilities {cap, boot} are elevate_client_require's own (unchanged; get_scope and consume_budget both need {}, only {mem}). Labels prefixed elcq_rs_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // row_id
        mov r13, rsi;                    // needed_caps
        mov r14, rdx;                    // scope_fp

        mov rdi, r12;
        mov rsi, r13;
        call elevate_client_require;
        cmp rax, 0;
        jne elcq_rs_out;                 // passthrough (already correctly banded)

        // (2) Scope match: bound scope == 0 (unscoped) OR == scope_fp.
        mov rdi, r12;
        call elevate_client_cap_get_scope;
        cmp rax, 0;
        je  elcq_rs_scope_ok;            // unscoped -- matches anything
        cmp rax, r14;
        je  elcq_rs_scope_ok;
        // Mismatch.
        mov rdi, 4;                      // ELCA_ST_SCOPE_MISMATCH
        call elevate_client_require_note;
        mov rax, 0xFFFFEA62;             // ELCA_ERR_SCOPE_MISMATCH
        jmp elcq_rs_out;

      elcq_rs_scope_ok:
        // (3) Budget consume.
        mov rdi, r12;
        call elevate_client_cap_consume_budget;
        cmp rax, 0;
        je  elcq_rs_ok;
        mov r10, 0xFFFFEA3A;             // ELCC_ERR_BUDGET_EXHAUSTED
        cmp rax, r10;
        jne elcq_rs_out;                 // some other ELCC_ERR_* -- passthrough
        push rax;
        sub rsp, 8;
        mov rdi, 5;                      // ELCA_ST_BUDGET_EXHAUSTED
        call elevate_client_require_note;
        add rsp, 8;
        pop rax;
        jmp elcq_rs_out;

      elcq_rs_ok:
        xor rax, rax;                    // ELCA_OK

      elcq_rs_out:
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }
}
