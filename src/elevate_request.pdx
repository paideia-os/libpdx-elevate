// src/elevate_request.pdx -- libpdx-elevate.M1-001 (paideia-os/libpdx-elevate#1)
//
// Client-side elevate request builder.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// The library-side mirror of paideia-os's ElevateChannel wire schema
// (src/kernel/core/ipc/elevate_channel.pdx, R48.M7-001 #1549).  Provides:
//
//   * The wire constants (ELV_OP_*, ELV_CAP_MASK_VALID, ELV_DUR_MIN/MAX_NS,
//     ELV_ERR_* band) so a client library user does not need to link the
//     paideia-os kernel tree to name them.
//   * The REQ-frame layout offsets (ELEVATE_REQ_OFF_*) and total size
//     (ELEVATE_REQ_FRAME_BYTES).
//   * Client-side validators (elevate_request_cap_mask_valid,
//     elevate_request_duration_valid) that mirror the kernel's
//     elv_mask_valid / elv_dur_valid so an ill-formed request can be
//     refused before the broker sees it (a mis-behaved client wastes
//     both a broker cycle and an audit-journal entry otherwise).
//   * elevate_request_pack_op_word(caps, dur) -- the op-word packer
//     that mirrors the kernel's elv_pack_req at
//     src/kernel/core/ipc/elevate_channel.pdx:171.  Returns the packed
//     op word (op | (caps << 8)) on success or an ELV_ERR_* code.
//   * elevate_request_write_frame(buf, caps, dur) -- assembles a full
//     32-byte REQ frame (op_word + caps body + duration body + reserved
//     body) into a caller-provided buffer.  This is the "build a
//     request struct, pack it" half of the M1 baseline; the "send to
//     svc.elevate-broker, block on reply" half lives in
//     elevate_client.pdx (M1-002 / issue #2).
//
// =============================================================================
// WHY REDECLARE THE WIRE CONSTANTS
// =============================================================================
//
// paideia-os owns the authoritative declarations in ElevateChannel.
// This library ships as a SEPARATE repo (paideia-os/libpdx-elevate) that
// is not obligated to link against the kernel .o graph at build time --
// a downstream tool (pkg, cp, mv, rm) links libpdx-elevate but does not
// necessarily link every ipc/*.o.  Redeclaring the wire constants here
// with an explicit "mirror of kernel ElevateChannel.<name>" pointer
// keeps the client library self-sufficient AND documents the invariant
// that the two must move together.  Any drift is caught at M4 by the
// smoke matrix comparing packer outputs against the kernel's own
// elv_pack_req over the same (caps, dur) inputs.
//
// =============================================================================
// WIRE FRAME (REQ)
// =============================================================================
//
// A REQ frame is 32 bytes on the wire:
//
//   [0..8)   op_word     packed: [7:0]=ELV_OP_REQ, [23:8]=caps, [63:24]=0
//   [8..16)  caps        u64 body word 0 -- authoritative caps bitmask
//   [16..24) duration_ns u64 body word 1 -- requested duration in ns
//   [24..32) reserved    u64 body word 2 -- always 0
//
// The op_word encoding is redundant with body word 0 (caps appears in
// both) by design: the kernel packer keeps the caps bitmask in the op
// word so a fast-path approver can classify a REQ without decoding the
// body.  The body carries the same value so the audit journal has a
// single canonical source when the record is materialised.
//
// =============================================================================
// ERROR BAND 0xFFFFE5E0..0xFFFFE5EF (shared with kernel ElevateChannel)
// =============================================================================
//
//   0xFFFFE5E9  ELV_ERR_DUR_EXCEEDS_CEILING (NEW LE.M4-001 -- client-side:
//                                           dur > per-cap-mask ceiling for
//                                           at least one bit set in caps)
//   0xFFFFE5EA  ELV_ERR_BAD_BUF   (NEW -- client-side: buf pointer null)
//   0xFFFFE5EB  ELV_ERR_BAD_GRANT (kernel: approver invariant violated)
//   0xFFFFE5EC  ELV_ERR_BAD_RSV   (kernel: reserved-bit set)
//   0xFFFFE5ED  ELV_ERR_BAD_DUR   (both: duration out of [1s, 1h])
//   0xFFFFE5EE  ELV_ERR_BAD_MASK  (both: reserved-bit set or mask == 0)
//   0xFFFFE5EF  ELV_ERR_BAD_OP    (kernel: op not in [1,3])
//
// Codes 0xFFFFE5E0..0xFFFFE5E8 stay reserved for future client-side
// errors (see also libpdx-elevate ELVC_* band in elevate_client.pdx,
// which occupies 0xFFFFEA00..0xFFFFEA0F).
//
// =============================================================================
// LE.M4-001: PER-CAP-MASK DURATION CEILINGS
// =============================================================================
//
// The legacy `elevate_request_duration_valid` gate applies one flat
// [1s, 1h] range regardless of which cap bits the REQ names.  Read-only
// or enumerate-shaped caps are safe at 1h; destructive caps (unlink,
// mount, /system write) are not.  LE.M4-001 introduces a per-cap-mask
// ceiling table (_elv_bit_ceiling_ns) and a new validator
// (elevate_request_duration_valid_for) that returns
// ELV_ERR_DUR_EXCEEDS_CEILING when the requested duration exceeds the
// combined mask's ceiling (the min ceiling over every set bit).
//
// The packer (elevate_request_pack_op_word) runs the new gate as its
// third check, immediately after the flat range gate; every callsite
// that already routes through the packer (including
// elevate_request_write_frame) inherits ceiling enforcement without a
// separate wire-in.  The legacy elevate_request_duration_valid entry
// point stays available for source-compat but is DEPRECATED for
// pre-packer client-side gating; new callers should use the
// per-cap-aware validator.
//
// Bit-to-ceiling mapping is documented at _elv_bit_ceiling_ns.

module ElevateRequest = structure {

  // ---- Wire constants -- mirror of paideia-os ElevateChannel ----

  pub let ELV_OP_REQ    : u64 = 0x01
  pub let ELV_OP_APR    : u64 = 0x02
  pub let ELV_OP_EXP    : u64 = 0x03
  pub let ELV_OP_MAX    : u64 = 0x03

  pub let ELV_CAP_MASK_VALID : u64 = 0x00FF   // bits 0..7

  pub let ELV_DUR_MIN_NS : u64 = 1000000000            // 1 sec
  pub let ELV_DUR_MAX_NS : u64 = 3600000000000         // 1 hour

  pub let ELV_OK                       : u64 = 0
  pub let ELV_ERR_DUR_EXCEEDS_CEILING  : u64 = 0xFFFFE5E9  // LE.M4-001 (#29)
  pub let ELV_ERR_BAD_BUF              : u64 = 0xFFFFE5EA
  pub let ELV_ERR_BAD_GRANT            : u64 = 0xFFFFE5EB
  pub let ELV_ERR_BAD_RSV              : u64 = 0xFFFFE5EC
  pub let ELV_ERR_BAD_DUR              : u64 = 0xFFFFE5ED
  pub let ELV_ERR_BAD_MASK             : u64 = 0xFFFFE5EE
  pub let ELV_ERR_BAD_OP               : u64 = 0xFFFFE5EF

  // ---- LE.M4-001: per-cap-mask duration ceilings ------------------
  //
  // Named ceilings for the five request classes called out in issue
  // #29's acceptance criteria.  Every value is in nanoseconds so it
  // can be compared directly against a duration_ns argument without
  // unit conversion.  Read-only classes (ENUMERATE/READ) share the
  // 1 h ceiling used by the legacy flat gate; every write-shaped
  // class shrinks below that.  All five exceed imm32 and MUST be
  // staged in a register before any compare (`mov r10, <val>; cmp
  // rdi, r10`), matching the ELV_DUR_MIN_NS / ELV_DUR_MAX_NS
  // discipline elsewhere in this module.
  //
  // These constants are the CATEGORY ceilings; the per-bit ceiling
  // table (_elv_bit_ceiling_ns) is what the validator walks.  Each
  // bit in the wire cap mask is classified into one of these five
  // categories per the mapping documented at the table.

  pub let ELV_CAP_R_ENUMERATE : u64 = 3600000000000        // 1 h
  pub let ELV_CAP_R_READ      : u64 = 3600000000000        // 1 h
  pub let ELV_CAP_R_WRITE     : u64 =   60000000000        // 60 s
  pub let ELV_CAP_R_UNLINK    : u64 =   30000000000        // 30 s
  pub let ELV_CAP_R_MOUNT     : u64 =   30000000000        // 30 s

  // ---- REQ frame layout ----

  pub let ELEVATE_REQ_FRAME_BYTES : u64 = 32
  pub let ELEVATE_REQ_OFF_OP      : u64 = 0
  pub let ELEVATE_REQ_OFF_CAPS    : u64 = 8
  pub let ELEVATE_REQ_OFF_DUR     : u64 = 16
  pub let ELEVATE_REQ_OFF_RSV     : u64 = 24

  // ---- LE.M4-001: per-bit ceiling table ---------------------------
  //
  // Slot i holds the max duration (ns) tolerated for a REQ that has
  // bit i of the cap mask set.  The combined ceiling of a mask with
  // multiple bits set is min(slot_i) over every set bit -- the most
  // restrictive category wins.  Bits 8..63 are reserved (refused by
  // elevate_request_cap_mask_valid before this table is ever read),
  // so only slots 0..7 are meaningful.
  //
  // Bit-to-wire-meaning is fixed by
  // src/kernel/core/ipc/elevate_channel.pdx §2 CAP BITMASK LAYOUT:
  //
  //   bit 0  PDXFS_WRITE_PKGS    -> WRITE    60 s
  //   bit 1  NETWORK_FETCH_PKGS  -> WRITE    60 s   (fetch mutates the
  //                                                  pkgs-mirror cache)
  //   bit 2  SIG_VERIFY_ROOT     -> READ     1 h   (pure verify, no
  //                                                  side effect beyond
  //                                                  the caller's own
  //                                                  read of the result)
  //   bit 3  PDXFS_WRITE_SYSTEM  -> UNLINK   30 s  (/system is the most
  //                                                  destructive write
  //                                                  target; issue AC
  //                                                  §"90 s destructive
  //                                                  -> refused")
  //   bit 4  USER_CREATE         -> WRITE    60 s
  //   bit 5  USER_REVOKE         -> UNLINK   30 s  (user-revoke deletes
  //                                                  a principal, same
  //                                                  irreversibility
  //                                                  class as unlink)
  //   bit 6  HW_MINT             -> WRITE    60 s  (unknown-category
  //                                                  default per issue
  //                                                  AC §"conservative
  //                                                  = write's 60s")
  //   bit 7  DRIVER_MINT         -> WRITE    60 s  (same conservative
  //                                                  default)
  //
  // Read-only after link.  Cache-line aligned so the whole table
  // fits in one 64-byte line for the walk.  Sizeof = 8 * 8 = 64 B.

  pub let _elv_bit_ceiling_ns : [u64; 8] =
    [ 60000000000,      // bit 0  PDXFS_WRITE_PKGS      WRITE
      60000000000,      // bit 1  NETWORK_FETCH_PKGS    WRITE
      3600000000000,    // bit 2  SIG_VERIFY_ROOT       READ
      30000000000,      // bit 3  PDXFS_WRITE_SYSTEM    UNLINK
      60000000000,      // bit 4  USER_CREATE           WRITE
      30000000000,      // bit 5  USER_REVOKE           UNLINK
      60000000000,      // bit 6  HW_MINT               WRITE (default)
      60000000000 ]     // bit 7  DRIVER_MINT           WRITE (default)

  // ==========================================================================
  // elevate_request_cap_mask_valid(mask) -> 1 | 0
  //
  // 1 iff mask != 0 AND no reserved bits (8..63) are set.
  //
  // Mirror of kernel elv_mask_valid at
  // src/kernel/core/ipc/elevate_channel.pdx:114.  Same discipline: a REQ
  // that names no caps is not honoured (nothing to grant), and a mask
  // with a reserved bit is refused rather than silently masked.
  // ==========================================================================

  pub let elevate_request_cap_mask_valid : (u64) -> u64 !{} @{} =
    fn (mask: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "libpdx-elevate.M1-001 (#1): mirror of kernel elv_mask_valid. 1 iff mask != 0 AND (mask & 0xFF) == mask (no reserved bits). Uses `mov r10, 0xFF; and rax, r10; cmp rax, rdi` to detect reserved bits without a NOT instruction -- same trick as the kernel mirror. Leaf function; no callee-save writes. Labels prefixed elreq_mv_.",
      block: {
        cmp rdi, 0;
        je  elreq_mv_no;
        mov rax, rdi;
        mov r10, 0xFF;
        and rax, r10;
        cmp rax, rdi;
        jne elreq_mv_no;
        mov rax, 1;
        ret;
      elreq_mv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // elevate_request_duration_valid(dur) -> 1 | 0
  //
  // 1 iff dur in [ELV_DUR_MIN_NS, ELV_DUR_MAX_NS].
  //
  // Mirror of kernel elv_dur_valid at
  // src/kernel/core/ipc/elevate_channel.pdx:141.  Both endpoints exceed
  // imm32 so they are staged in r10/r11 per the paideia-as compliance
  // discipline (no `cmp reg, imm64`).
  //
  // DEPRECATED (LE.M4-001, #29): the flat [1s, 1h] range is too
  // permissive for destructive caps.  Kept for source-compat -- the
  // packer still runs this gate as its second check for the specific
  // ELV_ERR_BAD_DUR return -- but new callers wanting a pre-packer
  // client-side check SHOULD use elevate_request_duration_valid_for
  // (which subsumes this gate's semantic for any non-empty cap mask,
  // since every per-cap ceiling is <= ELV_DUR_MAX_NS by construction).
  // ==========================================================================

  pub let elevate_request_duration_valid : (u64) -> u64 !{} @{} =
    fn (dur: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "libpdx-elevate.M1-001 (#1): mirror of kernel elv_dur_valid. Both bounds (1e9 ns and 3.6e12 ns) exceed imm32; staged in r10 / r11 for the compare. Leaf function. Labels prefixed elreq_dv_. DEPRECATED at LE.M4-001 (#29) in favor of elevate_request_duration_valid_for; kept for source-compat + still called by the packer for the ELV_ERR_BAD_DUR specific return.",
      block: {
        mov r10, 1000000000;             // ELV_DUR_MIN_NS
        cmp rdi, r10;
        jb  elreq_dv_no;
        mov r11, 3600000000000;          // ELV_DUR_MAX_NS
        cmp rdi, r11;
        ja  elreq_dv_no;
        mov rax, 1;
        ret;
      elreq_dv_no:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // elevate_request_duration_valid_for(caps, dur) -> 1 | ELV_ERR_DUR_EXCEEDS_CEILING
  //
  // LE.M4-001 (#29): per-cap-mask duration ceiling gate.  For every
  // bit set in caps, dur MUST NOT exceed that bit's ceiling in the
  // _elv_bit_ceiling_ns table.  Equivalently, dur MUST be <= the
  // combined mask's ceiling, defined as min(_elv_bit_ceiling_ns[i])
  // over every set bit i.
  //
  // Return:
  //   1                                on pass
  //   ELV_ERR_DUR_EXCEEDS_CEILING      on fail (dur > combined ceiling)
  //
  // This gate does NOT re-validate the flat [1s, 1h] range -- the
  // packer runs elevate_request_duration_valid first for the
  // ELV_ERR_BAD_DUR specific return.  It also does NOT re-validate
  // the cap mask; a caller passing reserved bits (>= bit 8) will
  // find those bits' ceilings walked as 0 iff the table were 8
  // slots long past the reserved boundary, but since the loop is
  // bounded at 8 iterations the reserved bits are simply ignored
  // here (elevate_request_cap_mask_valid is the layer that refuses
  // reserved bits, and the packer runs that gate first).
  //
  // Semantics on caps == 0: the loop finds no set bits, running_min
  // stays at ELV_DUR_MAX_NS (1 h), and any dur <= 1 h passes.  This
  // is not a code path a well-formed caller can reach because
  // elevate_request_cap_mask_valid refuses mask == 0 before the
  // packer would call this validator; documented for completeness.
  //
  // Register plan: no CALL is issued, no callee-save push needed.
  // r10 = caps working copy (shifted right by 1 each iter, bit-0
  // test).  r11 = running_min (initialised to ELV_DUR_MAX_NS =
  // 3600e9 ns, staged via movabs since it exceeds imm32).  rcx =
  // table base VA (RIP-relative).  rax = bit index 0..7 (also
  // doubles as the return-value register at exit).  r8, r9 =
  // scratch for the per-iter bit test and table load.
  // Labels prefixed elreq_dvf_.
  // ==========================================================================

  pub let elevate_request_duration_valid_for : (u64, u64) -> u64 !{} @{} =
    fn (caps: u64) (dur: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "libpdx-elevate.LE.M4-001 (#29): per-cap-mask duration ceiling gate. Walk bits 0..7 of caps; for each set bit look up its ceiling in the read-only _elv_bit_ceiling_ns[8] table and keep the running min. Compare dur against the running min; return 1 on pass or ELV_ERR_DUR_EXCEEDS_CEILING (0xFFFFE5E9, LE.M4-001 slot in band 0xFFFFE5E0..EF) on fail. NO nested CALL -> NO callee-save push -> NO alignment pad -> straight-line leaf function. Register plan: r10=caps working copy (shifted right by 1 each iteration so bit-0 test suffices), r11=running_min (initialised via movabs to ELV_DUR_MAX_NS = 3600e9 ns which exceeds imm32), rcx=table base VA via lea [rip + _elv_bit_ceiling_ns], rax=bit index 0..7 (also the return value at exit -- fresh rax write on both exits), r8/r9=per-iter scratch. Loop bound rax < 8 uses `cmp rax, 8` (fits imm32). Per-iter bit-0 test uses `mov r8, r10; and r8, 1; cmp r8, 0; je next` -- the and-imm8 form is safe on r8 (only `and rN, imm64` is refused by the encoder, per repo memory). Table load uses `mov r9, [rcx + rax * 8]` -- the SIB [reg + reg * 8] shape used already at elevate_client.pdx:176/192, elevate_client_require.pdx:164/180, and elsewhere. Running min update: `cmp r9, r11; jae skip; mov r11, r9` keeps the smaller ceiling. Right-shift caps by 1 (`shr r10, 1`) makes the next bit occupy bit 0 for the next iteration; `add rax, 1` walks the table index in parallel. At the exit compare, `cmp rsi, r11` (dur vs running_min); `ja` branches to the exceed exit which stages 0xFFFFE5E9 via `mov rax, 0xFFFFE5E9` -- the value exceeds signed imm32 so the encoder emits movabs (same discipline as `mov rax, 0xFFFFE5EE` in elevate_request_pack_op_word's BAD_MASK exit at L216). Pass exit stages `mov rax, 1`. Both exits `ret` directly (no unwind). This validator is invoked by elevate_request_pack_op_word as its third gate (LE.M4-001 wire-in); no other caller today, but its stability contract matches every other public entry point in this module.",
      block: {
        mov r10, rdi;                    // caps working copy
        mov r11, 3600000000000;          // running_min = ELV_DUR_MAX_NS (1 h)
        lea rcx, [rip + _elv_bit_ceiling_ns];
        xor rax, rax;                    // bit index i = 0

      elreq_dvf_loop:
        cmp rax, 8;
        jae elreq_dvf_check;

        mov r8, r10;
        and r8, 1;
        cmp r8, 0;
        je  elreq_dvf_next;

        mov r9, [rcx + rax * 8];
        cmp r9, r11;
        jae elreq_dvf_next;
        mov r11, r9;

      elreq_dvf_next:
        shr r10, 1;
        add rax, 1;
        jmp elreq_dvf_loop;

      elreq_dvf_check:
        cmp rsi, r11;
        ja  elreq_dvf_exceed;
        mov rax, 1;
        ret;

      elreq_dvf_exceed:
        mov rax, 0xFFFFE5E9;             // ELV_ERR_DUR_EXCEEDS_CEILING
        ret
      }
    }

  // ==========================================================================
  // elevate_request_pack_op_word(caps, dur) -> op_word | ELV_ERR_*
  //
  // Op-word encoding:
  //   [7:0]  op = ELV_OP_REQ
  //   [23:8] caps_bitmask (16 bits, but constrained to 8 by mask valid)
  //   [63:24] reserved 0
  //
  // Mirror of kernel elv_pack_req at
  // src/kernel/core/ipc/elevate_channel.pdx:171.  Note: the packer only
  // produces the op word.  The duration is validated here but is carried
  // separately in body word 1 (see elevate_request_write_frame).
  // ==========================================================================

  pub let elevate_request_pack_op_word : (u64, u64) -> u64 !{} @{} =
    fn (caps: u64) (dur: u64) -> unsafe {
      effects: {}, capabilities: {},
      justification: "libpdx-elevate.M1-001 (#1), extended at LE.M4-001 (#29) with a per-cap-mask ceiling gate: mirror of kernel elv_pack_req. Gates: (1) elevate_request_cap_mask_valid -> BAD_MASK. (2) elevate_request_duration_valid -> BAD_DUR (flat [1s, 1h] range). (3) LE.M4-001 elevate_request_duration_valid_for(caps, dur) -> ELV_ERR_DUR_EXCEEDS_CEILING (per-bit ceiling min-wins). Composition: op | (caps & 0xFF) << 8. Two callee-save pushes (r12, r13) preserve caps + dur across the three nested validator calls; r12 = caps, r13 = dur. Two pushes = 16 bytes, keeps rsp%16 stable across every nested call (same discipline as elevate_broker_register / elev_pack_req). The LE.M4-001 gate is the third and final validator call before the op-word composition; the ceiling validator returns 1 on pass or 0xFFFFE5E9 on fail, discriminated via `cmp rax, 1; jne` (fail path takes rax through unchanged since the returned error code is already the value we want to propagate). Because every callsite of elevate_request_write_frame flows through this packer, the ceiling gate propagates transparently -- write_frame's existing `shr rax, 24; jnz` propagation clause treats 0xFFFFE5E9 the same as every other ELV_ERR_* in the 0xFFFF band and returns it unchanged with buf UNMODIFIED. Labels prefixed elreq_po_.",
      block: {
        push r12;
        push r13;

        mov r12, rdi;                    // caps
        mov r13, rsi;                    // dur

        mov rdi, r12;
        call elevate_request_cap_mask_valid;
        cmp rax, 0;
        je  elreq_po_bad_mask;

        mov rdi, r13;
        call elevate_request_duration_valid;
        cmp rax, 0;
        je  elreq_po_bad_dur;

        // LE.M4-001 (#29): per-cap-mask ceiling gate.  Returns 1 on
        // pass or ELV_ERR_DUR_EXCEEDS_CEILING (0xFFFFE5E9) on fail;
        // the fail-path branch keeps rax unchanged so the returned
        // error propagates directly to the caller (and, through
        // elevate_request_write_frame's pack-err propagation, to
        // any write_frame consumer as well).
        mov rdi, r12;
        mov rsi, r13;
        call elevate_request_duration_valid_for;
        cmp rax, 1;
        jne elreq_po_bad_ceiling;

        mov rax, 1;                      // ELV_OP_REQ
        mov r10, r12;
        and r10, 0xFF;
        shl r10, 8;
        or  rax, r10;
        pop r13;
        pop r12;
        ret;

      elreq_po_bad_mask:
        mov rax, 0xFFFFE5EE;             // ELV_ERR_BAD_MASK
        pop r13;
        pop r12;
        ret;
      elreq_po_bad_dur:
        mov rax, 0xFFFFE5ED;             // ELV_ERR_BAD_DUR
        pop r13;
        pop r12;
        ret;
      elreq_po_bad_ceiling:
        // rax already carries ELV_ERR_DUR_EXCEEDS_CEILING (0xFFFFE5E9)
        // from the elevate_request_duration_valid_for return.
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // elevate_request_write_frame(buf, caps, dur) -> ELV_OK | ELV_ERR_*
  //
  // Assemble a full 32-byte REQ frame at the caller-provided buffer:
  //
  //   [buf +  0]  op_word    from elevate_request_pack_op_word
  //   [buf +  8]  caps       body word 0 -- authoritative caps bitmask
  //   [buf + 16]  duration   body word 1 -- requested duration in ns
  //   [buf + 24]  reserved   body word 2 -- always 0
  //
  // Return codes:
  //   ELV_OK                        frame written; every field validated.
  //   ELV_ERR_BAD_BUF               buf is 0 (nullptr) -- the library
  //                                 never writes to 0.
  //   ELV_ERR_BAD_MASK              caps mask invalid; buf UNCHANGED.
  //   ELV_ERR_BAD_DUR               duration out of flat [1s, 1h] range;
  //                                 buf UNCHANGED.
  //   ELV_ERR_DUR_EXCEEDS_CEILING   duration exceeds per-cap-mask ceiling
  //                                 (LE.M4-001, #29); buf UNCHANGED.
  //
  // The discriminator for pack failure vs success: a valid packed op
  // word has bits [63:24] == 0 (op fits in 8 bits + caps mask fits in
  // 16 bits = 24 bits total).  Every ELV_ERR_* code is in the 0xFFFF...
  // band (including LE.M4-001's ELV_ERR_DUR_EXCEEDS_CEILING = 0xFFFFE5E9),
  // so `shr rax, 24; jnz` cleanly discriminates.
  // ==========================================================================

  pub let elevate_request_write_frame : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (buf: u64) (caps: u64) (dur: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-elevate.M1-001 (#1): assemble a full 32-byte REQ frame into caller-provided buf. Three callee-save pushes (r12=buf, r13=caps, r14=dur) + one alignment pad (sub rsp, 8) = 32 bytes, keeps rsp aligned across the nested pack call. Buf gate refuses buf==0 up-front, so a null-deref never reaches the store instructions. On pack failure the ELV_ERR_* code from the packer propagates unchanged; buf is left UNMODIFIED so the caller can distinguish 'nothing written' from 'partial write' (there is no partial-write path -- the four stores happen only after every gate passes). Labels prefixed elreq_wf_.",
      block: {
        push r12;
        push r13;
        push r14;
        sub rsp, 8;                      // align

        cmp rdi, 0;
        je  elreq_wf_bad_buf;

        mov r12, rdi;                    // buf
        mov r13, rsi;                    // caps
        mov r14, rdx;                    // dur

        mov rdi, r13;
        mov rsi, r14;
        call elevate_request_pack_op_word;
        // rax = op_word (valid: bits [63:24] == 0) OR ELV_ERR_* (0xFFFF... band).
        mov r10, rax;
        shr r10, 24;
        cmp r10, 0;
        jne elreq_wf_pack_err;

        // op_word -> [buf + 0]
        mov [r12 + 0], rax;
        // caps -> [buf + 8]
        mov [r12 + 8], r13;
        // dur -> [buf + 16]
        mov [r12 + 16], r14;
        // reserved (0) -> [buf + 24]
        xor rax, rax;
        mov [r12 + 24], rax;

        xor rax, rax;                    // ELV_OK
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        ret;

      elreq_wf_pack_err:
        // rax already carries the ELV_ERR_* value from the packer.
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        ret;

      elreq_wf_bad_buf:
        mov rax, 0xFFFFE5EA;             // ELV_ERR_BAD_BUF
        add rsp, 8;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }
}
