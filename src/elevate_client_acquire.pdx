// src/elevate_client_acquire.pdx -- libpdx-elevate.ENH-001 (paideia-os/libpdx-elevate#11)
//
// elevate_client_acquire -- composed flow returning a grant HANDLE.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// The post-1.0.0 enhancement audit (.plans/enhancement-plan.md §3)
// found the elevate gate to be "an advisory boolean, not a
// credential": elevate_client_request_ex (M2) returns a STATUS code
// and leaves the APR in the caller's reply_buf, but minting the actual
// Cap<KIND_ELEVATE_CHANNEL> is a separate, optional call
// (elevate_client_cap_mint) a consumer may simply never make. Nothing
// the privileged operation subsequently performs consumes anything the
// elevate hop produced -- so "did I ask?" is a fact recorded nowhere
// the destructive code path is forced to look, and skipping the
// question on one branch (the `rm -r` regression that motivated this
// audit) is invisible at every level.
//
// elevate_client_acquire closes that gap structurally: it composes the
// full retry+journal+dispatch flow (elevate_client_request_ex_r, M3)
// with the mint (elevate_client_cap_mint, M2-003) and the two shadow
// bindings the mint needs (elevate_client_cap_bind_expire_abs,
// elevate_client_cap_bind_grant -- both new at this issue, in
// elevate_client_cap.pdx) into ONE call that returns a row_id --  a
// HANDLE -- on success. A caller now threads that row_id into the
// privileged operation and re-asserts it per-op via
// elevate_client_require (elevate_client_require.pdx, ENH-002).
// Omitting the gate becomes a MISSING ARGUMENT to the privileged
// helper, not a skipped statement invisible in a diff.
//
// This does NOT replace elevate_client_request_ex or
// elevate_client_request_ex_r -- a caller that only wants the status-
// shaped answer (no cap, no handle) keeps using those. It also does
// NOT attempt to know anything about what the caller is protecting
// (no path, no argv, no filesystem vocabulary) -- see the enhancement
// plan's "recommendation against" a --recursive-aware helper. The
// mint's target_cap_kind / target_cap_rights are opaque caller inputs,
// exactly as elevate_client_cap_mint already requires them to be.
//
// =============================================================================
// mint_ctx_buf LAYOUT -- 40 BYTES, FIVE u64 WORDS
// =============================================================================
//
// elevate_client_cap_mint already takes six SysV arguments; composing
// it with the six-argument elevate_client_request_ex_r would need 11
// distinct live values (target_cap_rights is orthogonal to caps/dur/
// req_buf/reply_ep_id/reply_buf), which does not fit paideia-os's
// established 6-register SysV window (confirmed by the same codebase-
// wide grep noted in elevate_client_send.pdx). Rather than invent a
// 7+-argument call, this follows the SAME idiom req_buf/reply_buf
// already establish: a caller-owned scratch buffer carrying the
// values elevate_client_cap_mint would otherwise take positionally.
//
//   [+0]   parent_ep_slot     -- cap-table slot of the caller's
//                                 KIND_IPC_ENDPOINT cap over the
//                                 broker (NOT the bare endpoint_id
//                                 elevate_client_lookup_broker
//                                 returns -- see kind_elevate_channel.
//                                 pdx's parent-gate note in paideia-os)
//   [+8]   request_id         -- caller-chosen identifier stored in
//                                 the minted row (elevate_channel_
//                                 row_req)
//   [+16]  requester_pid      -- caller's own pid (elevate_channel_
//                                 row_pid); this library has no
//                                 process-context primitive of its
//                                 own, so the caller supplies it,
//                                 exactly as a direct
//                                 elevate_client_cap_mint call already
//                                 requires
//   [+24]  target_cap_kind    -- kind of the DOWNSTREAM capability
//                                 this elevate channel governs
//                                 (opaque to this library)
//   [+32]  target_cap_rights  -- rights of that downstream capability
//                                 (opaque to this library)
//
// The mint's own `rights` argument (the elevate channel's OWN rights,
// distinct from target_cap_rights) is NOT read from this buffer: it is
// fixed at ELCC_RIGHTS_ALL (elevate_client_cap.pdx) because narrowing
// is stubbed until libpdx-cap.M2 lands (elevate_client_cap_narrow_stub
// is a passthrough today) -- there is no partial-rights value this
// composed flow could meaningfully request yet.
//
// =============================================================================
// SEQUENCE
// =============================================================================
//
//   (1) Gate mint_ctx_buf != 0                   -> ELCA_ERR_BAD_BUF.
//   (1b) Gate reply_buf != 0                     -> ELCA_ERR_BAD_REPLY_BUF
//        (LE.M2-hardening G9, #52: steps 4-5 read
//        [reply_buf+8] and [reply_buf+16], so null must
//        refuse with a diagnostic, not #PF).
//   (2) elevate_client_request_ex_r(caps, dur, req_buf, reply_ep_id,
//       reply_buf, timeout_ns=0) -- the full M3 flow: policy-classified
//       timeout, REQ+APR audit journaling, retry-with-backoff on
//       transient broker unavailability.  timeout_ns is always 0
//       (auto-select fast/human by policy classification) -- a caller
//       wanting manual timeout control keeps using
//       elevate_client_request_ex_r directly and composes the mint
//       itself.  Non-zero return (ELVC_ERR_* / ELVJ_ERR_* /
//       ELVR_ERR_*) passes straight through: no mint is attempted
//       without a validated grant.
//   (3) elevate_client_cap_mint(parent_ep_slot, ELCC_RIGHTS_ALL,
//       request_id, requester_pid, target_cap_kind, target_cap_rights)
//       -- args (1),(3),(4),(5) read from mint_ctx_buf.  Mint failure
//       (ELCC_ERR_MINT_FAIL) passes through.
//   (4) elevate_client_cap_bind_expire_abs(row_id, reply_buf[+16]) --
//       shadow the broker's OWN absolute expire_ns (not a client-side
//       re-derivation; see that function's doc for why bind_expire's
//       relative form would be wrong here).
//   (5) elevate_client_cap_bind_grant(row_id, reply_buf[+8]) -- shadow
//       the granted_caps so elevate_client_require can answer "does
//       this handle still cover X" without a broker hop.
//   (6) Return row_id.
//
// =============================================================================
// RETURN DISCRIMINATION
// =============================================================================
//
// row_id is always < 16 (ELCC_MAX_ROWS). Every error this function or
// anything it calls can produce is >= 0xFFFFEA00. A caller therefore
// discriminates with one bounded compare -- `cmp rax, 16; jae refuse`
// -- with no adjacent band to confuse it with a valid handle. This is
// the same "typed enum, not 0-vs-nonzero" discipline ENH-005 (#12)
// applied to the transport layer, carried through to the handle layer.
//
// =============================================================================
// ERROR BAND 0xFFFFEA50..0xFFFFEA5F
// =============================================================================
//
//   0xFFFFEA50  ELCA_ERR_BAD_BUF        -- mint_ctx_buf is 0
//   0xFFFFEA51  ELCA_ERR_BAD_REPLY_BUF  -- LE.M2-hardening G9 (#52):
//                                            reply_buf is 0; steps 4-5
//                                            would #PF on the field
//                                            loads at [reply_buf+8]
//                                            and [reply_buf+16].
//
// Every other non-success return is a passthrough from a composed
// call (ELVC_*, ELVJ_ERR_*, ELVR_ERR_*, ELCC_ERR_*) -- this function
// does not re-wrap them, so the ORIGINAL band identifies which layer
// refused.

module ElevateClientAcquire = structure {

  pub let ELCA_OK          : u64 = 0
  pub let ELCA_ERR_BAD_BUF : u64 = 0xFFFFEA50

  // LE.M2-hardening G9 (#52): distinct diagnostic for a null reply_buf.
  // Pre-fix the function dereferenced reply_buf ([r15+8] granted_caps,
  // [r15+16] expire_ns) without a null gate; every caller happened to
  // pass a real buffer today, but a null (accidentally uninitialised
  // stack slot / a defensive integration test / a shim caller) would
  // #PF inside libpdx-elevate rather than surface a diagnostic the
  // consumer could branch on.  Distinct from ELCA_ERR_BAD_BUF (which
  // covers mint_ctx_buf) so a caller can tell "you forgot the
  // context" from "you forgot the reply buffer".
  pub let ELCA_ERR_BAD_REPLY_BUF : u64 = 0xFFFFEA51

  // ==========================================================================
  // elevate_client_acquire(caps, dur, req_buf, reply_ep_id, reply_buf,
  //                        mint_ctx_buf) -> row_id | ELVC_*/ELVJ_ERR_*/
  //                                          ELVR_ERR_*/ELCC_ERR_*/ELCA_ERR_*
  //
  // See the file header for the full sequence and the mint_ctx_buf
  // layout. Register plan:
  //
  //   rbx = caps          (passed to request_ex_r)
  //   r12 = dur, then reused post-mint as row_id (dur is dead after
  //         the request_ex_r call; reusing the slot avoids a seventh
  //         callee-save push)
  //   r13 = req_buf       (passed to request_ex_r)
  //   r14 = reply_ep_id   (passed to request_ex_r)
  //   r15 = reply_buf     (read at [+8]/[+16] after a successful APR)
  //   rbp = mint_ctx_buf  (read at [+0..+32] before the mint call)
  //
  // Six callee-save pushes + one 8-byte alignment pad = 56 bytes;
  // entry rsp%16==8 -> (8-56) mod 16 == 0 across every nested call
  // (elevate_client_request_ex_r, elevate_client_cap_mint,
  // elevate_client_cap_bind_expire_abs, elevate_client_cap_bind_grant)
  // -- same shape as elevate_client_request_ex_j / _ex_r.
  // ==========================================================================

  // ==========================================================================
  // elevate_client_acquire_ctx(caps, dur, req_buf, reply_ep_id, reply_buf,
  //                            ctx_buf)
  //   -> row_id | ELVC_*/ELVJ_*/ELVR_*/ELCC_*/ELCA_*
  //
  // LE.M1-002 (#20).  Explicit-context twin of elevate_client_acquire.
  // Byte-for-byte the same composed flow (request_ex_r -> cap_mint ->
  // bind_expire_abs -> bind_grant) with ONE swap: step 2 dispatches
  // through elevate_client_request_ex_r_ctx (which itself threads the
  // ctx_buf through _ex_j_ctx and _ex_ctx) instead of elevate_client_
  // request_ex_r. The mint and shadow-bind steps are UNCHANGED in
  // spirit: the mint reads from a caller-owned 40-byte mint_ctx buffer
  // (same 5-word layout it always used, described in this file's
  // header block), and the two shadow-binds read only from reply_buf.
  //
  // WHY SIX ARGS (was seven in the initial LE.M1-002 draft):
  //
  // paideia-as's unsafe-body encoder caps lambda parameters at 6 --
  // the hard limit is B1708 "@no_frame (or unsafe-bodied) lambda
  // cannot accept more than 6 parameters". SAFE-bodied lambdas do
  // support 7+ args (7th at [rsp+8] on callee entry, per crates/
  // paideia-as tests/build-emit/sysv_x64_7arg_callee_stack_read.pdx),
  // but every asm block in this library uses `unsafe { ... }` -- the
  // whole point of these entry points is the inline-asm composed
  // flow, so demoting one function to a safe body to escape the cap
  // would be architecturally wrong. Instead we fold mint_ctx_buf's
  // pointer INTO the ctx_buf at [+32]: ctx_buf grows from 4 words /
  // 32 bytes (ENH-006 layout) to 5 words / 40 bytes. See the
  // ELVC_CTX_*_OFF authoritative layout in elevate_client_send.pdx.
  // _ex_j_ctx and _ex_r_ctx are UNCHANGED -- they never read [+32],
  // so the extra slot is invisible to them; a caller composing only
  // those two entry points may keep passing a 32-byte buffer.
  //
  // Gate order (matches acquire's own layout):
  //   (1)  ctx_buf == 0        -> ELVC_ERR_BAD_CTX (from send module's
  //                                extension band)
  //   (2)  mint_ctx_buf == 0   -> ELCA_ERR_BAD_BUF   (mint_ctx_buf is
  //                                read from [ctx_buf + 32] once gate 1
  //                                has passed; a 0 there means the
  //                                caller supplied a ctx but forgot to
  //                                populate the mint slot)
  //   (3)  reply_buf == 0      -> ELCA_ERR_BAD_REPLY_BUF
  //
  // ctx_buf is gated FIRST because it is the widest surface: an unset
  // ctx would poison the entire downstream chain (target_fp_lo == 0
  // triggers ELVJ_ERR_BAD_ACTOR at journal_req; the caller sees an
  // opaque ELVJ_ code rather than a diagnostic pointing at the bad
  // arg). mint_ctx_buf and reply_buf gates keep their relative order
  // from elevate_client_acquire (mint_ctx_buf wins on both-bad; here
  // reachable only when gate 1 has already passed).
  //
  // Register plan:
  //   rbx = caps            (arg to _ex_r_ctx)
  //   r12 = dur, then reused post-mint as row_id (dur dead after
  //         _ex_r_ctx, mirroring acquire's own r12 reuse discipline)
  //   r13 = req_buf         (arg to _ex_r_ctx)
  //   r14 = reply_ep_id     (arg to _ex_r_ctx)
  //   r15 = reply_buf       (read at [+8]/[+16] after a grant)
  //   rbp = ctx_buf         (6th arg; [rbp+32] holds mint_ctx_buf ptr,
  //                          loaded once at step 3 into r10 for the
  //                          mint arg-marshalling)
  //
  // Six callee-save pushes + one 8-byte alignment pad = 56 bytes;
  // entry rsp%16==8 -> (8-56) mod 16 == 0 across every nested call,
  // matching acquire's own shape. No stack-passed arg (was 7-arg in
  // the initial draft; see WHY SIX ARGS above).
  // ==========================================================================

  pub let elevate_client_acquire_ctx : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{boot, cap} =
    fn (caps: u64) (dur: u64) (req_buf: u64) (reply_ep_id: u64) (reply_buf: u64) (ctx_buf: u64) -> unsafe {
      effects: {mem}, capabilities: {boot, cap},
      justification: "libpdx-elevate.LE.M1-002 (#20): explicit-context twin of elevate_client_acquire. SIX arguments -- reduced from an initial 7-arg draft after paideia-as's unsafe-body encoder refused >6 params (error B1708: @no_frame or unsafe-bodied lambdas cap at 6 register args; SAFE-bodied lambdas support 7+ via stack-passed 7th at [rsp+8] on entry, but every asm block in this library uses `unsafe { ... }`). Fix folds mint_ctx_buf into ctx_buf at [+32]: ctx_buf grows to 5 words / 40 bytes (see the ELVC_CTX_*_OFF header block in elevate_client_send.pdx for the authoritative layout). Frame shape mirrors acquire exactly: six callee-save pushes (rbx=caps, r12=dur/row_id, r13=req_buf, r14=reply_ep_id, r15=reply_buf, rbp=ctx_buf) + one 8-byte alignment pad = 56 bytes; entry rsp%16==8 -> (8-56) mod 16 == 0 across every nested call. Gate order: ctx_buf==0 FIRST (widest surface -- an unset ctx would silently poison the whole chain via ELVJ_ERR_BAD_ACTOR at journal_req), then mint_ctx_buf==0 (loaded from [rbp+32]) via ELCA_ERR_BAD_BUF, then reply_buf==0 via ELCA_ERR_BAD_REPLY_BUF -- same relative priority as elevate_client_acquire's own (mint_ctx_buf wins on both-bad; reachable only when ctx is good). ctx_buf==0 returns ELVC_ERR_BAD_CTX (0xFFFFEA06) from the send module's extension band -- the same code elevate_client_request_ex_ctx and _ex_j_ctx / _ex_r_ctx use, so a caller sees ONE code across every ctx entry point. ONE swap vs. acquire's own step 2: dispatch through elevate_client_request_ex_r_ctx (which threads ctx through _ex_j_ctx and _ex_ctx) instead of _ex_r. Steps 3-5 are copied verbatim from acquire (mint from mint_ctx_buf loaded via [rbp+32] into r10 -- r10 is caller-saved and never overwritten between the load and the six arg-marshal moves that follow it; then bind_expire_abs and bind_grant from reply_buf). r12 is reused as the row_id stash post-mint because dur is dead once _ex_r_ctx has run -- matches acquire's own r12 reuse. capabilities {boot, cap} match the exact union of the two capability-bearing callees (unchanged from acquire). Labels prefixed elca_aqc_ (disjoint from acquire's elca_aq_). Every error immediate (0xFFFFEA06, 0xFFFFEA50, 0xFFFFEA51) exceeds imm32 for a `mov rax, imm32`, so is written as `mov rax, imm64` (paideia-as sign-extends `mov rax, imm32`; a raw immediate compare would drift into the negative half of the signed range).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;                      // alignment (see justification)

        mov rbx, rdi;                    // caps
        mov r12, rsi;                    // dur
        mov r13, rdx;                    // req_buf
        mov r14, rcx;                    // reply_ep_id
        mov r15, r8;                     // reply_buf
        mov rbp, r9;                     // ctx_buf

        // ---- Gate 1: ctx_buf != 0 (widest surface) ----
        cmp rbp, 0;
        je  elca_aqc_bad_ctx;

        // ---- Gate 2: mint_ctx_buf (at [ctx+32]) != 0 ----
        mov rax, [rbp + 32];
        cmp rax, 0;
        je  elca_aqc_bad_buf;

        // ---- Gate 3: reply_buf != 0 (LE.M2-hardening G9 discipline) ----
        cmp r15, 0;
        je  elca_aqc_bad_reply_buf;

        // ---- Step 2: full retry+journal+dispatch flow (ctx twin) ----
        mov rdi, rbx;                    // caps
        mov rsi, r12;                    // dur
        mov rdx, r13;                    // req_buf
        mov rcx, r14;                    // reply_ep_id
        mov r8,  r15;                    // reply_buf
        mov r9,  rbp;                    // ctx_buf
        call elevate_client_request_ex_r_ctx;
        cmp rax, 0;
        jne elca_aqc_out;                // ELVC_*/ELVJ_*/ELVR_* passthrough

        // ---- Step 3: mint the elevate channel cap ----
        // mint_ctx_buf pointer lives at [ctx+32]; load once into r10
        // (caller-saved, untouched by the six arg-marshal moves below)
        // and index off it for the mint arg-marshalling.
        mov r10, [rbp + 32];             // r10 = mint_ctx_buf
        mov rdi, [r10 + 0];              // parent_ep_slot
        mov rsi, 0x418;                  // ELCC_RIGHTS_ALL
        mov rdx, [r10 + 8];              // request_id
        mov rcx, [r10 + 16];             // requester_pid
        mov r8,  [r10 + 24];             // target_cap_kind
        mov r9,  [r10 + 32];             // target_cap_rights
        call elevate_client_cap_mint;
        cmp rax, 16;
        jae elca_aqc_out;                // ELCC_ERR_MINT_FAIL passthrough

        mov r12, rax;                    // row_id (dur no longer live)

        // ---- Step 4: shadow the broker's absolute expire_ns ----
        mov rdi, r12;
        mov rsi, [r15 + 16];
        call elevate_client_cap_bind_expire_abs;
        cmp rax, 0;
        jne elca_aqc_out;

        // ---- Step 5: shadow the granted_caps ----
        mov rdi, r12;
        mov rsi, [r15 + 8];
        call elevate_client_cap_bind_grant;
        cmp rax, 0;
        jne elca_aqc_out;

        // ---- Step 6: the handle IS the row_id ----
        mov rax, r12;
        jmp elca_aqc_out;

      elca_aqc_bad_ctx:
        mov rax, 0xFFFFEA06;             // ELVC_ERR_BAD_CTX
        jmp elca_aqc_out;

      elca_aqc_bad_buf:
        mov rax, 0xFFFFEA50;             // ELCA_ERR_BAD_BUF
        jmp elca_aqc_out;

      elca_aqc_bad_reply_buf:
        mov rax, 0xFFFFEA51;             // ELCA_ERR_BAD_REPLY_BUF

      elca_aqc_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }

  pub let elevate_client_acquire : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{boot, cap} =
    fn (caps: u64) (dur: u64) (req_buf: u64) (reply_ep_id: u64) (reply_buf: u64) (mint_ctx_buf: u64) -> unsafe {
      effects: {mem}, capabilities: {boot, cap},
      justification: "libpdx-elevate.ENH-001 (#11) refactored at LE.M1-002 (#20) into a THIN WRAPPER over elevate_client_acquire_ctx (6-arg call): snapshots the three process-global mutables via _elevate_client_build_default_ctx into a stack-local 40-byte ctx buffer with explicit_timeout=0 (acquire always used timeout=0 internally, so a 0 explicit_timeout preserves the auto-select-fast/human policy), stores the caller's mint_ctx_buf pointer at [ctx+32] (the acquire-only 5th ctx slot), then delegates. Public 6-arg signature unchanged (no source break); byte-identical to the pre-refactor behaviour in the single-threaded-of-intent case (retry stats, journal records, cap grant, shadow binds all identical). Six callee-save pushes to preserve args across get_target_fp_lo + sub rsp, 40 for the 40-byte stack ctx at [rsp+0..+40). Total 88 bytes off entry rsp; entry rsp%16==8 -> (8-88) mod 16 == 0 (88 mod 16 == 8) -- pre-CALL rsp aligned for both _elevate_client_build_default_ctx and the 6-arg call to _acquire_ctx. _elevate_client_build_default_ctx writes 32 bytes (words 0..3); word 4 (the mint_ctx_buf slot) is populated inline here immediately after the build call, so the ctx is fully valid before _acquire_ctx is entered. Labels prefixed elca_aq_ (retained from pre-refactor for continuity; disjoint from elca_aqc_ which the ctx twin uses).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 40;                     // 40-byte ctx at [rsp+0..+40)

        mov rbx, rdi;                    // caps
        mov r12, rsi;                    // dur
        mov r13, rdx;                    // req_buf
        mov r14, rcx;                    // reply_ep_id
        mov r15, r8;                     // reply_buf
        mov rbp, r9;                     // mint_ctx_buf

        // ---- Build a stack-local ctx snapshot from the globals. ----
        // acquire has always dispatched with timeout_ns=0 (auto-select
        // fast/human), so explicit_timeout=0 preserves that discipline.
        // _elevate_client_build_default_ctx writes 32 bytes (words 0..3);
        // word 4 is populated below.
        lea rdi, [rsp + 0];              // ctx_buf_out (40-byte buffer)
        xor rsi, rsi;                    // explicit_timeout_ns = 0
        call _elevate_client_build_default_ctx;

        // ---- Populate the acquire-only 5th slot: mint_ctx_buf ptr. ----
        mov [rsp + 32], rbp;

        // ---- Delegate to the ctx twin (6-arg SysV call). ----
        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        mov rcx, r14;
        mov r8,  r15;
        lea r9,  [rsp + 0];              // ctx_buf
        call elevate_client_acquire_ctx;
        // rax carries the delegated return.

        add rsp, 40;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
