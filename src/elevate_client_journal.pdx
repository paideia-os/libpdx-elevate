// src/elevate_client_journal.pdx -- libpdx-elevate.M3-001 (paideia-os/libpdx-elevate#6)
//
// Request + response journal via libpdx-audit (extends UEJ_KIND_ELEVATE).
//
// =============================================================================
// SCOPE
// =============================================================================
//
// The M3 audit-trail integration.  Every ElevateRequest REQ frame is
// journaled BEFORE it goes on the wire; every APR reply is journaled
// AFTER it comes back validated.  Two-record shape means an auditor
// can reconstruct the full policy negotiation from the journal alone,
// without having to intercept the transport.
//
// This lands the "audit trail integration" half of the M3 mandate at
// design/tooling/r49-r50-plan.md §5.14 M3.  The retry-with-backoff
// half lives in elevate_client_retry.pdx (M3-002, #7).
//
// =============================================================================
// LIBPDX-AUDIT ROUTING (LE.M2-002, libpdx-elevate#38)
// =============================================================================
//
// The design at r49-r50-plan.md §5.14 says "journals via libpdx-audit".
// libpdx-audit.M2 originally exported only the AuditClient trio
// (audit_begin / audit_record_output / audit_commit) with effect tail
// `!{mem, sysreg} @{cap, sched}` -- adopting that trio here would have
// propagated `sysreg`/`sched` up through every _ex_j / _ex_r / _acquire
// / _require_j entry point, a v2.0 cap-manifest ripple on every
// downstream tool.  libpdx-audit#31 unblocked the swap with a thin
// `!{mem} @{}` leaf, `audit_append_leaf(buf, buf_len, entry_ptr)`,
// which byte-copies one pre-composed 256-byte `PdxAuditRecord@0.2`
// record into a caller-owned sink buffer without touching the wire,
// without consuming a cap, and without a syscall.  Adopting that leaf
// preserves this module's `!{mem} @{}` effect posture and therefore
// leaves every downstream caller's effect signature unchanged.
//
// LE.M2-002 shape.  Each journal-emitting body
// (elevate_client_journal_req/_apr/_op, elevate_client_cap_attest,
// elevate_client_journal_revoke_cascade) now composes a
// `PdxAuditRecord@0.2` in the module-private scratch buffer
// `_elevate_client_audit_entry`, hands it to `audit_append_leaf` (which
// mirrors it into the module-private sink slot
// `_elevate_client_audit_sink`), THEN performs the existing
// `uej_append(UEJ_KIND_ELEVATE = 5, ...)` kernel-journal write.  The
// two-step is deliberate: the `audit_append_leaf` call is the "route
// through libpdx-audit" the M2 mandate requires, and the follow-up
// `uej_append` remains the durable kernel-visible record that gives
// this module its `seq | ELVJ_ERR_*` return contract and satisfies
// LE.M2-002's byte-identical-wire acceptance criterion.  The two paths
// are independent -- `audit_append_leaf`'s return is intentionally
// IGNORED (its worst outcome is a silently-overwritten sink slot; the
// durable `uej_append` return is what gates the caller-visible
// success/failure code and the audit-first invariant in
// elevate_client_request_ex_j).  The record layout mirrors the
// `AUDIT_OFF_*` offset table from libpdx-audit's `audit_record.pdx`:
// EVENT_KIND = UEJ_KIND_ELEVATE (5), PARENT_ID = actor_fp_lo,
// OUTPUT_HASH = the ELVJ_EVT_* discriminator, and the first qwords of
// OP_NAME / OP_ARGS carry the two body words (body1 / body2) that
// `uej_append` also writes on the wire; the remaining bytes of the
// 256-byte record are zeroed.
//
// =============================================================================
// RECORD LAYOUT (per uej_append)
// =============================================================================
//
// Every elevate audit record uses UEJ_KIND_ELEVATE = 5 and packs the
// event-specific fields into the three body words:
//
//   body0 = ELVJ_EVT_REQ (1) | ELVJ_EVT_APR (2) | ELVJ_EVT_ATTEST (4)
//                                                  -- discriminator
//   body1 = caps (REQ) | granted_caps (APR) | actor_fp_lo (ATTEST)
//   body2 = duration_ns (REQ) | expire_ns (APR) | reason_fp_lo (ATTEST)
//
// actor_fp_lo is the caller's low-64 fingerprint (mirrors the
// process-global _elevate_client_target_fp_lo set via
// elevate_client_set_target_fp_lo).  subject_fp_lo is 0 for elevate
// records (user_events_journal.pdx §1 explicitly documents "0 for
// elevate" so this is the intended convention).
//
// LE.M5-001 (#31): ELVJ_EVT_ATTEST records a delegation-with-
// attestation event -- an opaque caller-computed reason_fp_lo
// (typically blake3(reason_string)[0..8]) attached to a row_id BEFORE
// a derive.  Unlike REQ/APR/OP, ATTEST also stamps two per-row shadow
// fields in elevate_client_cap.pdx -- last_audit_seq and
// last_audit_kind -- via elevate_client_cap_bind_last_audit, so a
// later elevate_client_cap_derive call can gate on "was this parent
// attested since its last state change" (see LE.M5-002, #32).
// body1 duplicates actor_fp_lo (rather than reason_fp_lo twice) so an
// auditor reading only the journal (no row_id context) still learns
// who attested; reason_fp_lo lives in body2 alongside every other
// event's second payload word.
//
// =============================================================================
// PER-OP CONSENT NOTE
// =============================================================================
//
// The r49-r50-plan.md §5.14 M3 line names "each mutating op re-
// consulted against policy" as an M3 obligation.  The M2 entry point
// elevate_client_request_ex already runs elevate_client_policy_check
// on EVERY invocation (see elevate_client_send.pdx L613-L640) -- a
// caller cannot bypass the consult by holding a stale reference.  The
// M3 wrapper elevate_client_request_ex_j preserves that per-call
// discipline AND wraps each attempt with a REQ+APR journal pair, so
// the audit trail records the full consent sequence for every
// operation the caller performs.
//
// =============================================================================
// ERROR BAND 0xFFFFEA40..0xFFFFEA4F
// =============================================================================
//
//   0xFFFFEA40  ELVJ_ERR_BAD_ACTOR     -- actor_fp_lo is 0
//                                          (uej_append refuses 0 actor;
//                                          gate here so the caller
//                                          gets a stable client-band
//                                          error not the kernel band)
//   0xFFFFEA41  ELVJ_ERR_REQ_JOURNAL_FAIL
//                                       -- uej_append refused the REQ
//                                          record; the elevate is
//                                          aborted (audit-first D3).
//   0xFFFFEA42  ELVJ_ERR_APR_JOURNAL_FAIL
//                                       -- uej_append refused the APR
//                                          record after the elevate
//                                          succeeded.  The caller now
//                                          holds a grant that is NOT
//                                          audit-covered and MUST
//                                          revoke it (via elevate_
//                                          client_cap_check_and_revoke)
//                                          or the audit chain is
//                                          broken.
//   0xFFFFEA43  ELVJ_ERR_OP_JOURNAL_FAIL
//                                       -- uej_append refused the OP
//                                          record (ENH-004, #16).
//   0xFFFFEA44  ELVJ_ERR_ATTEST_JOURNAL_FAIL
//                                       -- uej_append refused the
//                                          ATTEST record (LE.M5-001,
//                                          #31).  No row shadow state
//                                          is stamped when this fires.
//   0xFFFFEA45  ELVJ_ERR_REVOKE_CASCADE_JOURNAL_FAIL
//                                       -- uej_append refused the
//                                          REVOKE_CASCADE record
//                                          (LE.M7-001, #35).  The
//                                          caller (elevate_client_cap_
//                                          revoke_cascade) deliberately
//                                          IGNORES this return -- see
//                                          that function's AUDIT +
//                                          ACTOR section for why a
//                                          failed revoke-audit does not
//                                          block the revoke itself.
//                                          Declared for completeness /
//                                          band coverage even though no
//                                          call site currently branches
//                                          on it.

module ElevateClientJournal = structure {

  // ---- Wire constants mirrored from user_events_journal.pdx ----

  pub let ELVJ_UEJ_KIND_ELEVATE : u64 = 5

  // ---- Event discriminators (body0 of the audit record) ----
  //
  // Chosen to overlap the wire ELV_OP_* codes for REQ (1) and APR (2)
  // so a reader who has both wire codes and journal discriminators in
  // hand can join them without a translation table.  EXP (3) does not
  // journal from the client side; the kernel EXP broadcast handler
  // journals its own record.

  pub let ELVJ_EVT_REQ : u64 = 1
  pub let ELVJ_EVT_APR : u64 = 2

  // ENH-004 (#16): per-op discriminator. Does NOT overlap a wire
  // ELV_OP_* code (the wire protocol has no "per-op use" frame -- this
  // event exists purely client-side, recording that
  // elevate_client_require authorized one use of an already-granted
  // handle). Chosen as 3 anyway, immediately after APR, so the three
  // discriminators read as a chronological sequence: REQ, APR, then
  // zero or more OP records per handle.
  pub let ELVJ_EVT_OP : u64 = 3

  // LE.M5-001 (#31): delegation-with-attestation discriminator.  Fires
  // from elevate_client_cap_attest, NOT from the request/response/op
  // flow above -- a caller invokes it explicitly, typically right
  // before elevate_client_cap_derive on a row whose bind_attestation_
  // required flag is set (LE.M5-002, #32).  Chosen as 4, immediately
  // after OP, so the four discriminators still read as a chronological
  // family even though ATTEST is not part of the REQ/APR/OP sequence
  // every handle goes through.
  pub let ELVJ_EVT_ATTEST : u64 = 4

  // LE.M7-001 (#35): per-row revoke-cascade discriminator.  Fires from
  // elevate_client_cap_revoke_cascade (elevate_client_cap.pdx), once
  // per row it successfully revokes at the kernel -- see that
  // function's AUDIT + ACTOR section.  Chosen as 5, immediately after
  // ATTEST, continuing the same chronological-family numbering the
  // three siblings above already establish.
  //
  // Issue #35's own acceptance-criteria text names this constant as
  // "= 6" -- an apparent slip (likely conflated with the unrelated
  // ELVJ_UEJ_KIND_ELEVATE = 5 wire-kind constant just above, a
  // different namespace entirely). 5 is the value actually landed:
  // it is the correct next-contiguous body0 discriminator (no
  // ELVJ_EVT_* value is currently assigned to 5), and leaving a
  // permanent gap at 5 to match the issue's literal text would cost
  // real clarity for zero benefit -- nothing anywhere in this library
  // or its consumers reserves 5 for anything else.
  pub let ELVJ_EVT_REVOKE_CASCADE : u64 = 5

  // ---- Result codes / error band 0xFFFFEA40..0xFFFFEA4F ----

  pub let ELVJ_OK                      : u64 = 0
  pub let ELVJ_ERR_BAD_ACTOR           : u64 = 0xFFFFEA40
  pub let ELVJ_ERR_REQ_JOURNAL_FAIL    : u64 = 0xFFFFEA41
  pub let ELVJ_ERR_APR_JOURNAL_FAIL    : u64 = 0xFFFFEA42
  pub let ELVJ_ERR_OP_JOURNAL_FAIL     : u64 = 0xFFFFEA43
  pub let ELVJ_ERR_ATTEST_JOURNAL_FAIL : u64 = 0xFFFFEA44
  pub let ELVJ_ERR_REVOKE_CASCADE_JOURNAL_FAIL : u64 = 0xFFFFEA45

  // Threshold used to discriminate uej_append return (seq | UEJ_ERR_*)
  // from a valid seq.  UEJ_MAX_RECORDS = 256 per user_events_journal.
  // pdx §1, so any rax >= 256 is an error.  Kept as a small imm so a
  // caller-side `cmp rax, 256` fits imm32 without staging.
  pub let ELVJ_UEJ_SEQ_MAX : u64 = 256

  // ---- Stats ----
  //
  //   0 req_writes    successful REQ journal appends
  //   1 apr_writes    successful APR journal appends
  //   2 req_fails     uej_append refused a REQ record
  //   3 apr_fails     uej_append refused an APR record
  //   4 bad_actor     caller passed actor_fp_lo == 0
  //   5 op_writes     successful per-op (ELVJ_EVT_OP) journal appends
  //                   (ENH-004, #16) -- this count, compared against
  //                   1 for the corresponding REQ/APR pair, IS the
  //                   grant-amplification signal: N op_writes under
  //                   one acquired handle means N mutating uses of a
  //                   single broker grant.
  //   6 op_fails      uej_append refused an OP record
  //   7 attest_writes successful ATTEST journal appends (LE.M5-001,
  //                   #31) -- was "reserved" pre-M5; the slot was never
  //                   read or written before this wave.
  //   8 attest_fails  uej_append refused an ATTEST record
  //   9 revoke_cascade_writes
  //                   successful REVOKE_CASCADE journal appends
  //                   (LE.M7-001, #35) -- was "reserved" pre-M7; the
  //                   slot was never read or written before this wave.
  //   10 revoke_cascade_fails
  //                   uej_append refused a REVOKE_CASCADE record

  pub let mut _elevate_client_journal_stats : [u64; 11] = uninit @align(64)

  pub let ELVJ_ST_REQ_WRITES    : u64 = 0
  pub let ELVJ_ST_APR_WRITES    : u64 = 1
  pub let ELVJ_ST_REQ_FAILS     : u64 = 2
  pub let ELVJ_ST_APR_FAILS     : u64 = 3
  pub let ELVJ_ST_BAD_ACTOR     : u64 = 4
  pub let ELVJ_ST_OP_WRITES     : u64 = 5
  pub let ELVJ_ST_OP_FAILS      : u64 = 6
  pub let ELVJ_ST_ATTEST_WRITES : u64 = 7
  pub let ELVJ_ST_ATTEST_FAILS  : u64 = 8
  pub let ELVJ_ST_REVOKE_CASCADE_WRITES : u64 = 9   // LE.M7-001 (#35)
  pub let ELVJ_ST_REVOKE_CASCADE_FAILS  : u64 = 10  // LE.M7-001 (#35)
  pub let ELVJ_ST_MAX           : u64 = 11

  // ==========================================================================
  // libpdx-audit mirror plumbing (LE.M2-002, libpdx-elevate#38)
  //
  // Two module-private .bss slots plus a shared staging helper.  Both
  // slots are 8-byte-aligned per libpdx-audit's `audit_append_leaf`
  // caller-obligation (audit_client.pdx L631-L638).  The sink slot is a
  // single-record buffer -- successive calls overwrite it -- because
  // this module's durable audit record is the follow-up `uej_append`
  // write, not the mirror.  A future consolidation that promotes the
  // mirror to the primary path can widen the sink to a rolling ring and
  // add a flush-to-svc.audit-journal transport; that widening lives
  // outside LE.M2-002.
  //
  // AUDIT_OFF_* offsets mirrored from libpdx-audit's audit_record.pdx
  // @0.2 layout (kept as file-local constants rather than re-exported
  // to avoid coupling libpdx-elevate's public surface to libpdx-audit's
  // internal offsets; if audit_record.pdx retargets the layout the swap
  // is a local edit here, not a downstream break).
  //
  //   AUDIT_OFF_AUDIT_ID        =   0   -- unused by the mirror (kept 0;
  //                                        seq numbering lives on the
  //                                        uej_append side)
  //   AUDIT_OFF_EVENT_KIND      =   8   -- UEJ_KIND_ELEVATE (5)
  //   AUDIT_OFF_EXIT_CODE       =  16   -- unused (kept 0)
  //   AUDIT_OFF_PARENT_ID       =  24   -- actor_fp_lo
  //   AUDIT_OFF_OUTPUT_HASH     =  32   -- ELVJ_EVT_* discriminator
  //   AUDIT_OFF_OP_NAME         =  40   -- body1 in first qword, 24 bytes
  //                                        zeroed tail
  //   AUDIT_OFF_OP_ARGS         =  72   -- body2 in first qword, 120 bytes
  //                                        zeroed tail
  //   AUDIT_OFF_OUTPUT_SCHEMA   = 200   -- zeroed (32 bytes)
  //   AUDIT_OFF_RESERVED        = 232   -- zeroed (24 bytes)

  pub let mut _elevate_client_audit_entry : [u8; 256] = uninit @align(8)
  pub let mut _elevate_client_audit_sink  : [u8; 256] = uninit @align(8)

  // ==========================================================================
  // _elevate_client_audit_stage(actor_fp_lo, body0_disc, body1, body2) -> ()
  //
  // Shared staging helper: compose a 256-byte PdxAuditRecord@0.2 in
  // `_elevate_client_audit_entry`, then hand it to `audit_append_leaf`
  // which byte-copies it into `_elevate_client_audit_sink`.  Return is
  // ignored -- the sink write is a best-effort mirror; the durable
  // record is the `uej_append` call the caller performs immediately
  // after this helper returns.
  //
  // Called from elevate_client_journal_req / _apr / _op /
  // cap_attest / journal_revoke_cascade at the same alignment point:
  // three callee-save pushes have just happened (rsp%16 == 0) so this
  // helper's CALL sees rsp%16 == 8; the helper's own `sub rsp, 8` pad
  // restores rsp%16 == 0 for the nested `audit_append_leaf` CALL, then
  // adds it back before ret.  No callee-save touched here (r10/r11/rax
  // are all caller-save; the caller has already stashed the values it
  // needs to survive the helper into r12/r13/r14 before invoking).
  //
  // Args (SysV): rdi=actor_fp_lo, rsi=body0_disc, rdx=body1, rcx=body2.
  // All four are captured into the entry buffer BEFORE the argument
  // registers are clobbered for the `audit_append_leaf` call
  // (audit_append_leaf takes rdi=buf, rsi=buf_len, rdx=entry_ptr).
  // ==========================================================================

  pub let _elevate_client_audit_stage : (u64, u64, u64, u64) -> () !{mem} @{} =
    fn (actor_fp_lo: u64) (body0_disc: u64) (body1: u64) (body2: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-elevate.LE.M2-002 (#38): shared staging helper that composes a 256-byte PdxAuditRecord@0.2 in _elevate_client_audit_entry then invokes libpdx-audit's audit_append_leaf to byte-copy it into _elevate_client_audit_sink. Kept private-by-convention (leading underscore) rather than a bare `let` because the entire module's declarations use `pub let`; downstream tools should NOT call this directly -- the five audit-emitting bodies below are the intended call sites. Alignment: every caller invokes this at rsp%16 == 0 (post three callee-save pushes, before any pad), so entry rsp%16 == 8; `sub rsp, 8` restores 0 for the nested audit_append_leaf CALL, `add rsp, 8` pre-ret. Register plan: rdi/rsi/rdx/rcx carry the four semantic fields on entry and are stored into the entry buffer BEFORE rdi/rsi/rdx are re-loaded for the audit_append_leaf call (audit_append_leaf takes rdi=buf, rsi=buf_len, rdx=entry_ptr). r10 holds &_elevate_client_audit_entry across the whole body; r11 is the zero-loop counter (0..32). No callee-save touched. rax is caller-save, used only as the zero source for the fill loop. Return from audit_append_leaf is IGNORED -- AUDIT_ERR_BUFFER_FULL cannot fire here because sink capacity (256) equals AUDIT_PAYLOAD_BYTES exactly, so the failure branch is unreachable by construction; a future rolling-sink variant would need to observe the return. Effects `!{mem} @{}` -- pure in-memory composition + audit_append_leaf's own !{mem} @{} leaf; no syscall, no cap. Immediates: 32 (zero-loop iteration count), 8 (per-iteration qword advance), 5 (UEJ_KIND_ELEVATE mirrored to AUDIT_OFF_EVENT_KIND), 256 (audit_append_leaf buf_len), and the AUDIT_OFF_* byte offsets (8/24/32/40/72) -- all within the imm32-sign-extended range. Constants staged to r11 before store since paideia-as `mov [mem], imm` is not the codebase convention -- every existing memory write in this module (see elevate_client_policy.pdx L322+) routes through a register. Labels prefixed elcs_ (elcs_zero_loop) so a future paideia-as file-scope label uniqueness pass keeps this helper's labels disjoint from every other function's elcj_/elcq_/elca_/elcc_ family.",
      block: {
        sub rsp, 8;                              // align for audit_append_leaf CALL

        // ---- Zero the 256-byte entry scratch (32 qwords). ----
        lea r10, [rip + _elevate_client_audit_entry];
        xor rax, rax;
        xor r11, r11;
      elcs_zero_loop:
        mov [r10 + r11 * 8], rax;
        add r11, 1;
        cmp r11, 32;
        jb  elcs_zero_loop;

        // ---- Populate the AUDIT_OFF_* fields the mirror carries. ----
        mov r11, 5;                              // UEJ_KIND_ELEVATE
        mov [r10 + 8],  r11;                     // AUDIT_OFF_EVENT_KIND
        mov [r10 + 24], rdi;                     // AUDIT_OFF_PARENT_ID   = actor_fp_lo
        mov [r10 + 32], rsi;                     // AUDIT_OFF_OUTPUT_HASH = body0 discriminator
        mov [r10 + 40], rdx;                     // AUDIT_OFF_OP_NAME[0]  = body1
        mov [r10 + 72], rcx;                     // AUDIT_OFF_OP_ARGS[0]  = body2

        // ---- Call audit_append_leaf(sink, 256, entry). Return ignored. ----
        lea rdi, [rip + _elevate_client_audit_sink];
        mov rsi, 256;
        mov rdx, r10;                            // entry_ptr (already in r10)
        call audit_append_leaf;

        add rsp, 8;
        ret
      }
    }

  // ==========================================================================
  // elevate_client_journal_reset() -> ()
  //
  // Scrub the stats table.  Boot / teardown only.  Same shape as
  // elevate_client_stats_reset (elevate_client.pdx).
  // ==========================================================================

  pub let elevate_client_journal_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-elevate.M3-001 (#6), extended to 10 slots at LE.M5-001 (#31) for the ATTEST write/fail counters, extended again to 11 at LE.M7-001 (#35) for the REVOKE_CASCADE write counter: clear the journal stats table. Boot / teardown discipline; a live counter reset would race any concurrent journal_req / journal_apr call. Leaf; single loop. Labels prefixed elcj_rs_.",
      block: {
        lea r10, [rip + _elevate_client_journal_stats];
        xor rax, rax;
        xor rcx, rcx;
      elcj_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 11;
        jb  elcj_rs_loop;
        ret
      }
    }

  pub let elevate_client_journal_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-elevate.M3-001 (#6), bound widened 8->10 at LE.M5-001 (#31), widened again 10->11 at LE.M7-001 (#35): bounded increment; out-of-range which is a no-op. Same shape as elevate_client_note (elevate_client.pdx L127). Labels prefixed elcj_nt_.",
      block: {
        cmp rdi, 11;
        jae elcj_nt_out;
        lea r10, [rip + _elevate_client_journal_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      elcj_nt_out:
        ret
      }
    }

  pub let elevate_client_journal_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-elevate.M3-001 (#6), bound widened 8->10 at LE.M5-001 (#31), widened again 10->11 at LE.M7-001 (#35): bounded read; out-of-range which returns 0 (0 is the correct answer for both 'never touched' and 'out of range' -- same convention as elevate_client_stat). Labels prefixed elcj_st_.",
      block: {
        cmp rdi, 11;
        jae elcj_st_zero;
        lea r10, [rip + _elevate_client_journal_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      elcj_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // elevate_client_journal_req(actor_fp_lo, caps, dur_ns)
  //   -> seq | ELVJ_ERR_*
  //
  // Append a REQ audit record via uej_append.  The kernel primitive
  // returns the assigned monotonic seq (< 256) on success or a
  // UEJ_ERR_* code (0xFFFFE5A[B-F]) on refusal.  We normalise any
  // failure code to ELVJ_ERR_REQ_JOURNAL_FAIL so callers only inspect
  // the client band -- the specific UEJ_ERR_* is observable via
  // ELVJ_ST_REQ_FAILS on the stats table.
  //
  // Preconditions:
  //   * actor_fp_lo != 0 (uej_append refuses 0-actor; we gate first
  //     so the caller sees a distinct ELVJ_ERR_BAD_ACTOR rather than
  //     an opaque REQ_JOURNAL_FAIL for a caller-side bug).
  //
  // Register plan: r12=actor, r13=caps, r14=dur; three callee-save
  // pushes + one 8-byte alignment pad = 32 bytes; entry rsp%16==8 ->
  // (8-32) mod 16 == 8 -- but a 3-push has (8-24) mod 16 == 0 so no
  // pad is needed for 3 pushes.  Wait: uej_append is a 6-arg call
  // whose args must all be live at the CALL site; keeping actor/caps/
  // dur in callee-save regs is what lets us pass them without a
  // second recompute.  3 pushes -> rsp%16 == 0 at CALL, no pad.
  // ==========================================================================

  pub let elevate_client_journal_req : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (actor_fp_lo: u64) (caps: u64) (dur_ns: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-elevate.M3-001 (#6), extended at LE.M2-002 (#38) to route the record through libpdx-audit's audit_append_leaf leaf before the durable uej_append call: append a REQ audit record. Three callee-save pushes (r12=actor, r13=caps, r14=dur) = 24 bytes; entry rsp%16==8 -> (8-24) mod 16 == 0 so BOTH the LE.M2-002 mirror CALL (_elevate_client_audit_stage) AND the follow-up uej_append CALL see aligned rsp -- no additional pad required. The stage helper itself handles its own inner alignment for the nested audit_append_leaf call. Gate order matches uej_append's own: actor_fp_lo != 0 first (an audit record with no actor is not verifiable, refuse rather than corrupt the audit trail with an anonymous entry) -- the mirror is skipped on the bad-actor path for the same reason. ELVJ_UEJ_KIND_ELEVATE (5) matches user_events_journal.pdx UEJ_KIND_ELEVATE. body0 = ELVJ_EVT_REQ (1) as the record discriminator; body1 = caps; body2 = dur_ns -- the mirror carries the same three values into the PdxAuditRecord's AUDIT_OFF_OUTPUT_HASH / OP_NAME / OP_ARGS slots (see _elevate_client_audit_stage). Kernel returns seq (< 256) on OK or UEJ_ERR_* (0xFFFFE5A[B-F]) on refusal; we discriminate via `cmp rax, 256` (256 fits imm32, no staging) and collapse any failure to ELVJ_ERR_REQ_JOURNAL_FAIL -- the specific UEJ_ERR_* is observable via ELVJ_ST_REQ_FAILS on the stats table. On success we bump ELVJ_ST_REQ_WRITES via elevate_client_journal_note. The mirror return is intentionally ignored: sink capacity == AUDIT_PAYLOAD_BYTES so AUDIT_ERR_BUFFER_FULL cannot fire, and even if a future rolling-sink variant surfaces a real refusal, the durable uej_append below is what feeds this function's caller-visible seq/error return contract. Labels prefixed elcj_jr_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // actor_fp_lo
        mov r13, rsi;                    // caps
        mov r14, rdx;                    // dur_ns

        // Gate: actor_fp_lo != 0.
        cmp r12, 0;
        je  elcj_jr_bad_actor;

        // ---- LE.M2-002: mirror through libpdx-audit BEFORE the durable
        //      uej_append below. Best-effort; return ignored. ---------------
        mov rdi, r12;                    // actor_fp_lo
        mov rsi, 1;                      // body0 = ELVJ_EVT_REQ
        mov rdx, r13;                    // body1 = caps
        mov rcx, r14;                    // body2 = dur_ns
        call _elevate_client_audit_stage;

        // uej_append(kind=5, actor, subject=0, body0=ELVJ_EVT_REQ,
        //            body1=caps, body2=dur_ns)
        mov rdi, 5;                      // ELVJ_UEJ_KIND_ELEVATE
        mov rsi, r12;                    // actor_fp_lo
        xor rdx, rdx;                    // subject_fp_lo = 0
        mov rcx, 1;                      // ELVJ_EVT_REQ
        mov r8,  r13;                    // caps
        mov r9,  r14;                    // dur_ns
        call uej_append;

        // rax >= 256 means UEJ_ERR_*; discriminate then normalise.
        cmp rax, 256;                    // ELVJ_UEJ_SEQ_MAX
        jae elcj_jr_fail;

        // Success -- bump ELVJ_ST_REQ_WRITES.
        push rax;                        // stash seq across the note call
        sub rsp, 8;                      // realign
        mov rdi, 0;                      // ELVJ_ST_REQ_WRITES
        call elevate_client_journal_note;
        add rsp, 8;
        pop rax;                         // restore seq

        pop r14;
        pop r13;
        pop r12;
        ret;

      elcj_jr_fail:
        mov rdi, 2;                      // ELVJ_ST_REQ_FAILS
        call elevate_client_journal_note;
        mov rax, 0xFFFFEA41;             // ELVJ_ERR_REQ_JOURNAL_FAIL
        pop r14;
        pop r13;
        pop r12;
        ret;

      elcj_jr_bad_actor:
        mov rdi, 4;                      // ELVJ_ST_BAD_ACTOR
        call elevate_client_journal_note;
        mov rax, 0xFFFFEA40;             // ELVJ_ERR_BAD_ACTOR
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // elevate_client_journal_apr(actor_fp_lo, granted_caps, expire_ns)
  //   -> seq | ELVJ_ERR_*
  //
  // Append an APR audit record.  Same shape as journal_req -- only
  // the body0 discriminator (ELVJ_EVT_APR = 2) and the body-word
  // semantics (granted / expire vs requested / duration) differ.
  //
  // The caller extracts granted_caps and expire_ns from the reply_buf
  // returned by elevate_client_request_ex (offsets [+8] and [+16] per
  // elevate_channel.pdx §1).  This function does not read reply_buf
  // itself so a caller that already has the two values in registers
  // does not pay an extra memory hop.
  //
  // A failure here after a successful elevate is the audit-trail-
  // broken case: the grant exists in the kernel table but no audit
  // record covers it.  The caller MUST then revoke the grant (via
  // elevate_client_cap_check_and_revoke) or the audit chain is broken.
  // The higher-level wrapper elevate_client_request_ex_j does exactly
  // that error surfacing.
  // ==========================================================================

  pub let elevate_client_journal_apr : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (actor_fp_lo: u64) (granted_caps: u64) (expire_ns: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-elevate.M3-001 (#6), extended at LE.M2-002 (#38) with the same libpdx-audit mirror the REQ path carries: append an APR audit record. Shape mirrors elevate_client_journal_req -- see that function's justification for the alignment / gate / mirror reasoning. Differences: body0 = ELVJ_EVT_APR (2); body1/body2 are (granted_caps, expire_ns) rather than (caps, dur_ns) -- the mirror carries the same three values into the PdxAuditRecord fields. Failure normalisation collapses UEJ_ERR_* to ELVJ_ERR_APR_JOURNAL_FAIL and bumps ELVJ_ST_APR_FAILS. Success bumps ELVJ_ST_APR_WRITES. Labels prefixed elcj_ja_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // actor_fp_lo
        mov r13, rsi;                    // granted_caps
        mov r14, rdx;                    // expire_ns

        cmp r12, 0;
        je  elcj_ja_bad_actor;

        // ---- LE.M2-002: mirror through libpdx-audit. --------------------
        mov rdi, r12;                    // actor_fp_lo
        mov rsi, 2;                      // body0 = ELVJ_EVT_APR
        mov rdx, r13;                    // body1 = granted_caps
        mov rcx, r14;                    // body2 = expire_ns
        call _elevate_client_audit_stage;

        mov rdi, 5;                      // ELVJ_UEJ_KIND_ELEVATE
        mov rsi, r12;                    // actor_fp_lo
        xor rdx, rdx;                    // subject_fp_lo = 0
        mov rcx, 2;                      // ELVJ_EVT_APR
        mov r8,  r13;                    // granted_caps
        mov r9,  r14;                    // expire_ns
        call uej_append;

        cmp rax, 256;                    // ELVJ_UEJ_SEQ_MAX
        jae elcj_ja_fail;

        push rax;
        sub rsp, 8;
        mov rdi, 1;                      // ELVJ_ST_APR_WRITES
        call elevate_client_journal_note;
        add rsp, 8;
        pop rax;

        pop r14;
        pop r13;
        pop r12;
        ret;

      elcj_ja_fail:
        mov rdi, 3;                      // ELVJ_ST_APR_FAILS
        call elevate_client_journal_note;
        mov rax, 0xFFFFEA42;             // ELVJ_ERR_APR_JOURNAL_FAIL
        pop r14;
        pop r13;
        pop r12;
        ret;

      elcj_ja_bad_actor:
        mov rdi, 4;                      // ELVJ_ST_BAD_ACTOR
        call elevate_client_journal_note;
        mov rax, 0xFFFFEA40;             // ELVJ_ERR_BAD_ACTOR
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // elevate_client_journal_op(actor_fp_lo, row_id, needed_caps)
  //   -> seq | ELVJ_ERR_*
  //
  // ENH-004 (#16).  Append a per-op audit record: one call per
  // AUTHORIZED use of an already-acquired handle (elevate_client_
  // require.pdx's elevate_client_require_j calls this on ELCA_OK
  // only -- a refused op is not journaled here because it is already
  // reflected in elevate_client_require's own stats table, and
  // journaling every ATTEMPT would make the OP count meaningless as an
  // amplification signal). Shape mirrors journal_req/journal_apr; body0
  // = ELVJ_EVT_OP (3), body1 = row_id, body2 = needed_caps.
  //
  // This is the record an auditor reads to detect grant amplification:
  // one REQ + one APR record establishes that ONE elevate was
  // authorized by the broker; the count of OP records against that
  // same actor_fp_lo (and, once a caller correlates by timestamp
  // ordering, that same row_id) shows how many mutating operations
  // were actually performed under it. A single grant covering 50,000
  // recursively-deleted files now leaves 50,000 OP records rather than
  // zero trace beyond the initial REQ/APR pair.
  //
  // Register plan / alignment: identical shape to journal_req --
  // three callee-save pushes (r12=actor, r13=row_id, r14=needed_caps)
  // = 24 bytes; entry rsp%16==8 -> (8-24) mod 16 == 0, no pad needed.
  // ==========================================================================

  pub let elevate_client_journal_op : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (actor_fp_lo: u64) (row_id: u64) (needed_caps: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-elevate.ENH-004 (#16), extended at LE.M2-002 (#38) with the same libpdx-audit mirror the REQ/APR paths carry: append a per-op audit record so grant amplification (1 REQ/APR pair, N mutating uses) is legible to an auditor. Shape mirrors elevate_client_journal_req -- see that function's justification for the alignment / gate / mirror reasoning; the only differences are body0 = ELVJ_EVT_OP (3) and body1/body2 = (row_id, needed_caps) rather than (caps, dur_ns). Failure normalises to ELVJ_ERR_OP_JOURNAL_FAIL and bumps ELVJ_ST_OP_FAILS; success bumps ELVJ_ST_OP_WRITES. Labels prefixed elcj_jo_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // actor_fp_lo
        mov r13, rsi;                    // row_id
        mov r14, rdx;                    // needed_caps

        cmp r12, 0;
        je  elcj_jo_bad_actor;

        // ---- LE.M2-002: mirror through libpdx-audit. --------------------
        mov rdi, r12;                    // actor_fp_lo
        mov rsi, 3;                      // body0 = ELVJ_EVT_OP
        mov rdx, r13;                    // body1 = row_id
        mov rcx, r14;                    // body2 = needed_caps
        call _elevate_client_audit_stage;

        mov rdi, 5;                      // ELVJ_UEJ_KIND_ELEVATE
        mov rsi, r12;                    // actor_fp_lo
        xor rdx, rdx;                    // subject_fp_lo = 0
        mov rcx, 3;                      // ELVJ_EVT_OP
        mov r8,  r13;                    // row_id
        mov r9,  r14;                    // needed_caps
        call uej_append;

        cmp rax, 256;                    // ELVJ_UEJ_SEQ_MAX
        jae elcj_jo_fail;

        push rax;
        sub rsp, 8;
        mov rdi, 5;                      // ELVJ_ST_OP_WRITES
        call elevate_client_journal_note;
        add rsp, 8;
        pop rax;

        pop r14;
        pop r13;
        pop r12;
        ret;

      elcj_jo_fail:
        mov rdi, 6;                      // ELVJ_ST_OP_FAILS
        call elevate_client_journal_note;
        mov rax, 0xFFFFEA43;             // ELVJ_ERR_OP_JOURNAL_FAIL
        pop r14;
        pop r13;
        pop r12;
        ret;

      elcj_jo_bad_actor:
        mov rdi, 4;                      // ELVJ_ST_BAD_ACTOR
        call elevate_client_journal_note;
        mov rax, 0xFFFFEA40;             // ELVJ_ERR_BAD_ACTOR
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // elevate_client_cap_attest(row_id, actor_fp_lo, reason_fp_lo)
  //   -> seq | ELVJ_ERR_*
  //
  // LE.M5-001 (#31).  Delegation-with-attestation record.  Appends
  // ONE ATTEST audit record (body0 = ELVJ_EVT_ATTEST = 4, body1 =
  // actor_fp_lo, body2 = reason_fp_lo) and, on success, stamps
  // row_id's shadow last_audit_seq / last_audit_kind fields
  // (elevate_client_cap.pdx, elevate_client_cap_bind_last_audit) so a
  // later elevate_client_cap_derive call can gate on "has this row
  // been attested" (LE.M5-002, #32).
  //
  // Named elevate_client_cap_* rather than elevate_client_journal_*
  // (unlike its req/apr/op siblings above) because its OBSERVABLE
  // effect is a cap-row stamp -- callers reason about it as "attest
  // this row", not "journal this event" -- even though it lives here
  // alongside uej_append's other call sites, keeping every direct
  // kernel-journal touch in one file.
  //
  // Preconditions:
  //   * actor_fp_lo != 0 (uej_append refuses 0-actor; gated first, same
  //     as journal_req / journal_apr / journal_op, so the caller sees
  //     ELVJ_ERR_BAD_ACTOR rather than an opaque ATTEST_JOURNAL_FAIL).
  //
  // row_id is NOT range-checked here: the append happens regardless
  // (an attestation is a fact about who/why independent of whether the
  // row_id is currently live), and the row-stamp step
  // (elevate_client_cap_bind_last_audit) silently no-ops on an
  // out-of-range row_id -- its ELCC_ERR_BAD_ROW return is intentionally
  // ignored here, mirroring elevate_client_cap_derive's own
  // best-effort treatment of a kernel revoke's return in its
  // elcc_dv_bind_fail path: the journal record already landed and
  // cannot be un-appended, so a bad row_id degrades to "the audit
  // trail exists but no row remembers it" rather than losing the
  // record entirely.
  //
  // Register plan: r12=row_id, r13=actor_fp_lo, r14=reason_fp_lo;
  // three callee-save pushes = 24 bytes; entry rsp%16==8 -> (8-24) mod
  // 16 == 0, matching journal_req/journal_apr/journal_op's shape. The
  // seq returned by uej_append is stashed on the stack (one push + an
  // 8-byte realignment pad, same idiom those three functions use)
  // across BOTH the bind_last_audit and journal_note calls before
  // being restored into rax.
  // ==========================================================================

  pub let elevate_client_cap_attest : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (row_id: u64) (actor_fp_lo: u64) (reason_fp_lo: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-elevate.LE.M5-001 (#31), extended at LE.M2-002 (#38) with the same libpdx-audit mirror the REQ/APR/OP paths carry: append an ATTEST audit record and stamp the row's shadow last_audit_seq/last_audit_kind. Three callee-save pushes (r12=row_id, r13=actor_fp_lo, r14=reason_fp_lo) = 24 bytes; entry rsp%16==8 -> (8-24) mod 16 == 0 so BOTH the mirror CALL (_elevate_client_audit_stage) AND the follow-up uej_append CALL see aligned rsp, matching journal_req/journal_apr/journal_op. Gate order: actor_fp_lo != 0 first, same as the three siblings; the mirror is skipped on the bad-actor path. body0 = ELVJ_EVT_ATTEST (4); body1 = actor_fp_lo (so an auditor reading only the journal, without row_id context, still learns who attested) -- the mirror carries the same actor duplication in its AUDIT_OFF_OP_NAME slot; body2 = reason_fp_lo. On success the uej_append seq is pushed once and the stack padded by 8 (rsp%16==0 across the two follow-on calls), then read back via [rsp+8] as the `seq` argument to elevate_client_cap_bind_last_audit (row_id, seq, kind=4) -- that call's return is deliberately ignored (best-effort row stamp; the journal record itself is the durable fact and cannot be un-appended if the row_id happens to be stale or out of range). ELVJ_ST_ATTEST_WRITES is bumped after the stamp attempt, still inside the same aligned window, before the stashed seq is restored into rax. Labels prefixed elcj_at_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // row_id
        mov r13, rsi;                    // actor_fp_lo
        mov r14, rdx;                    // reason_fp_lo

        // Gate: actor_fp_lo != 0.
        cmp r13, 0;
        je  elcj_at_bad_actor;

        // ---- LE.M2-002: mirror through libpdx-audit. body1 duplicates
        //      actor_fp_lo (mirroring the uej_append call below), so an
        //      auditor reading only the mirror still learns who attested. --
        mov rdi, r13;                    // actor_fp_lo
        mov rsi, 4;                      // body0 = ELVJ_EVT_ATTEST
        mov rdx, r13;                    // body1 = actor_fp_lo
        mov rcx, r14;                    // body2 = reason_fp_lo
        call _elevate_client_audit_stage;

        // uej_append(kind=5, actor=actor_fp_lo, subject=0,
        //            body0=ELVJ_EVT_ATTEST, body1=actor_fp_lo,
        //            body2=reason_fp_lo)
        mov rdi, 5;                      // ELVJ_UEJ_KIND_ELEVATE
        mov rsi, r13;                    // actor_fp_lo
        xor rdx, rdx;                    // subject_fp_lo = 0
        mov rcx, 4;                      // ELVJ_EVT_ATTEST
        mov r8,  r13;                    // body1 = actor_fp_lo
        mov r9,  r14;                    // body2 = reason_fp_lo
        call uej_append;

        cmp rax, 256;                    // ELVJ_UEJ_SEQ_MAX
        jae elcj_at_fail;

        // Success -- stamp the row's shadow last_audit fields, bump
        // the stat, then restore the seq into rax.
        push rax;                        // stash seq
        sub rsp, 8;                      // realign for the two calls below

        mov rdi, r12;                    // row_id
        mov rsi, [rsp + 8];              // seq (stashed just under the pad)
        mov rdx, 4;                      // ELVJ_EVT_ATTEST (last_audit_kind)
        call elevate_client_cap_bind_last_audit;  // return ignored -- best effort

        mov rdi, 7;                      // ELVJ_ST_ATTEST_WRITES
        call elevate_client_journal_note;

        add rsp, 8;
        pop rax;                         // restore seq

        pop r14;
        pop r13;
        pop r12;
        ret;

      elcj_at_fail:
        mov rdi, 8;                      // ELVJ_ST_ATTEST_FAILS
        call elevate_client_journal_note;
        mov rax, 0xFFFFEA44;             // ELVJ_ERR_ATTEST_JOURNAL_FAIL
        pop r14;
        pop r13;
        pop r12;
        ret;

      elcj_at_bad_actor:
        mov rdi, 4;                      // ELVJ_ST_BAD_ACTOR
        call elevate_client_journal_note;
        mov rax, 0xFFFFEA40;             // ELVJ_ERR_BAD_ACTOR
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // elevate_client_journal_revoke_cascade(actor_fp_lo, row_id,
  //                                       cascade_root_row_id)
  //   -> seq | ELVJ_ERR_*
  //
  // LE.M7-001 (#35).  Append a per-row REVOKE_CASCADE audit record: one
  // call per row elevate_client_cap_revoke_cascade (elevate_client_
  // cap.pdx) successfully revokes at the kernel. Shape mirrors journal_
  // op exactly -- see that function's doc for the alignment / gate
  // reasoning; the only differences are body0 = ELVJ_EVT_REVOKE_CASCADE
  // (5) and body1/body2 = (row_id, cascade_root_row_id) rather than
  // (row_id, needed_caps). row_id is the row just revoked; cascade_
  // root_row_id is the argument originally passed to revoke_cascade,
  // so an auditor reading the journal alone can join "this row was
  // revoked" to "because a cascade rooted at that row_id swept it up"
  // without needing the caller's own state.
  //
  // The caller (revoke_cascade) treats this call as best-effort and
  // ignores the return -- see that function's AUDIT + ACTOR section
  // for why a revoke's audit trail does not gate the revoke itself the
  // way a grant's does.
  //
  // Register plan / alignment: identical shape to journal_op -- three
  // callee-save pushes (r12=actor, r13=row_id, r14=cascade_root) = 24
  // bytes; entry rsp%16==8 -> (8-24) mod 16 == 0, no pad needed.
  // ==========================================================================

  pub let elevate_client_journal_revoke_cascade : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (actor_fp_lo: u64) (row_id: u64) (cascade_root_row_id: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-elevate.LE.M7-001 (#35), extended at LE.M2-002 (#38) with the same libpdx-audit mirror the REQ/APR/OP/ATTEST paths carry: append a per-row revoke-cascade audit record. Shape mirrors elevate_client_journal_op -- see that function's justification for the alignment / gate / mirror reasoning; the only differences are body0 = ELVJ_EVT_REVOKE_CASCADE (5) and body1/body2 = (row_id, cascade_root_row_id) rather than (row_id, needed_caps). Failure normalises to ELVJ_ERR_REVOKE_CASCADE_JOURNAL_FAIL and bumps ELVJ_ST_REVOKE_CASCADE_FAILS; success bumps ELVJ_ST_REVOKE_CASCADE_WRITES. Labels prefixed elcj_rc_.",
      block: {
        push r12;
        push r13;
        push r14;

        mov r12, rdi;                    // actor_fp_lo
        mov r13, rsi;                    // row_id (just revoked)
        mov r14, rdx;                    // cascade_root_row_id

        cmp r12, 0;
        je  elcj_rc_bad_actor;

        // ---- LE.M2-002: mirror through libpdx-audit. --------------------
        mov rdi, r12;                    // actor_fp_lo
        mov rsi, 5;                      // body0 = ELVJ_EVT_REVOKE_CASCADE
        mov rdx, r13;                    // body1 = row_id
        mov rcx, r14;                    // body2 = cascade_root_row_id
        call _elevate_client_audit_stage;

        mov rdi, 5;                      // ELVJ_UEJ_KIND_ELEVATE
        mov rsi, r12;                    // actor_fp_lo
        xor rdx, rdx;                    // subject_fp_lo = 0
        mov rcx, 5;                      // ELVJ_EVT_REVOKE_CASCADE
        mov r8,  r13;                    // row_id
        mov r9,  r14;                    // cascade_root_row_id
        call uej_append;

        cmp rax, 256;                    // ELVJ_UEJ_SEQ_MAX
        jae elcj_rc_fail;

        push rax;
        sub rsp, 8;
        mov rdi, 9;                      // ELVJ_ST_REVOKE_CASCADE_WRITES
        call elevate_client_journal_note;
        add rsp, 8;
        pop rax;

        pop r14;
        pop r13;
        pop r12;
        ret;

      elcj_rc_fail:
        mov rdi, 10;                     // ELVJ_ST_REVOKE_CASCADE_FAILS
        call elevate_client_journal_note;
        mov rax, 0xFFFFEA45;             // ELVJ_ERR_REVOKE_CASCADE_JOURNAL_FAIL
        pop r14;
        pop r13;
        pop r12;
        ret;

      elcj_rc_bad_actor:
        mov rdi, 4;                      // ELVJ_ST_BAD_ACTOR
        call elevate_client_journal_note;
        mov rax, 0xFFFFEA40;             // ELVJ_ERR_BAD_ACTOR
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // elevate_client_request_ex_j(caps, dur, req_buf, reply_ep_id,
  //                             reply_buf, timeout_ns)
  //   -> ELVC_* | ELVJ_ERR_*
  //
  // The M3 audit-wrapped full-flow entry point.  Sequence:
  //
  //   (1) Fetch actor_fp_lo from the process-global slot via
  //       elevate_client_get_target_fp_lo.  Note: a 0 actor means
  //       "not configured"; journal_req will refuse with BAD_ACTOR
  //       and the whole flow aborts before the wire hop, which is
  //       the audit-first D3 discipline (no unattributable elevate).
  //
  //   (2) elevate_client_journal_req(actor, caps, dur_ns).
  //       Failure -> return the ELVJ_ERR_* without ever touching the
  //       wire.  This is the "audit-first" gate: no audit record ->
  //       no operation.
  //
  //   (3) elevate_client_request_ex(caps, dur, req_buf, reply_ep_id,
  //                                 reply_buf, timeout_ns).
  //       Non-zero return -> pass the ELVC_ERR_* back to the caller
  //       (no APR to journal on failure; the REQ record already
  //       captures the attempt).
  //
  //   (4) On ELVC_OK, extract granted_caps from reply_buf[+8] and
  //       expire_ns from reply_buf[+16] (per elevate_channel.pdx §1),
  //       call elevate_client_journal_apr.  If THAT fails, override
  //       the return with ELVJ_ERR_APR_JOURNAL_FAIL so the caller
  //       knows to revoke the just-granted cap (audit chain is broken
  //       otherwise).
  //
  // Register plan matches elevate_client_request_ex: six callee-save
  // pushes + one 8-byte pad = 56 bytes; entry rsp%16==8 -> (8-56) mod
  // 16 == 0 across every nested call.  We repurpose the pad slot at
  // [rsp+0] as the stash for actor_fp_lo so we do not need a seventh
  // callee-save.
  //
  //   rbx = caps         (needed by journal_req)
  //   r12 = dur          (needed by journal_req)
  //   r13 = req_buf      (passed to elevate_client_request_ex)
  //   r14 = reply_ep_id  (passed to elevate_client_request_ex)
  //   r15 = reply_buf    (needed after ex to journal the APR body)
  //   rbp = timeout_ns   (passed to elevate_client_request_ex)
  //   [rsp+0] = actor_fp_lo  (stashed after step 1)
  // ==========================================================================

  pub let elevate_client_request_ex_j : (u64, u64, u64, u64, u64, u64) -> u64 !{mem} @{boot} =
    fn (caps: u64) (dur: u64) (req_buf: u64) (reply_ep_id: u64) (reply_buf: u64) (timeout_ns: u64) -> unsafe {
      effects: {mem}, capabilities: {boot},
      justification: "libpdx-elevate.M3-001 (#6): audit-wrapped full-flow entry point. Six callee-save pushes (rbx, r12, r13, r14, r15, rbp) + one 8-byte alignment pad = 56 bytes; entry rsp%16==8 -> (8-56) mod 16 == 0 so every nested call (get_target_fp_lo, journal_req, elevate_client_request_ex, journal_apr) sees aligned rsp. The pad slot at [rsp+0] doubles as the stash for actor_fp_lo (avoids a seventh callee-save push). Audit-first D3 discipline: journal_req failure aborts before the wire hop (no operation without an audit record). APR-journal failure after a successful elevate returns ELVJ_ERR_APR_JOURNAL_FAIL so the caller knows to revoke the freshly-granted cap. reply_buf granted_caps at [+8] and expire_ns at [+16] match the ElevateChannel wire spec at src/kernel/core/ipc/elevate_channel.pdx §1. Capability {boot} propagates from the nested elevate_client_request_ex (which pulls it from elevate_client_recv_reply's hpet_now_ns). ELVJ_ERR_* codes exceed imm32 so any equality compare against them stages the constant into r10 first; we only need one such compare here (in the APR-journal failure branch) so it is written inline. Labels prefixed elcj_rx_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;
        push rbp;
        sub rsp, 8;                      // align + stash slot for actor_fp_lo

        mov rbx, rdi;                    // caps
        mov r12, rsi;                    // dur
        mov r13, rdx;                    // req_buf
        mov r14, rcx;                    // reply_ep_id
        mov r15, r8;                     // reply_buf
        mov rbp, r9;                     // timeout_ns

        // ---- Step 1: fetch actor_fp_lo from the process-global ----
        call elevate_client_get_target_fp_lo;
        mov [rsp + 0], rax;              // stash actor_fp_lo

        // ---- Step 2: journal the REQ (audit-first gate) ----
        mov rdi, rax;                    // actor_fp_lo
        mov rsi, rbx;                    // caps
        mov rdx, r12;                    // dur_ns
        call elevate_client_journal_req;
        // rax >= 256 means ELVJ_ERR_* -- pass through.
        cmp rax, 256;
        jb  elcj_rx_journaled;
        // Journal refused -> abort before the wire hop.  rax already
        // holds the ELVJ_ERR_REQ_JOURNAL_FAIL / ELVJ_ERR_BAD_ACTOR code.
        jmp elcj_rx_out;

      elcj_rx_journaled:
        // ---- Step 3: do the elevate ----
        mov rdi, rbx;                    // caps
        mov rsi, r12;                    // dur
        mov rdx, r13;                    // req_buf
        mov rcx, r14;                    // reply_ep_id
        mov r8,  r15;                    // reply_buf
        mov r9,  rbp;                    // timeout_ns
        call elevate_client_request_ex;
        cmp rax, 0;
        jne elcj_rx_out;                 // ELVC_ERR_* -> pass through

        // ---- Step 4: journal the APR (audit chain closer) ----
        mov rdi, [rsp + 0];              // actor_fp_lo
        mov rsi, [r15 + 8];              // granted_caps
        mov rdx, [r15 + 16];             // expire_ns
        call elevate_client_journal_apr;
        // Success (rax < 256) collapses to ELVC_OK; failure (rax in
        // 0xFFFFEA4* band) surfaces as-is so the caller knows the
        // grant is not audit-covered.
        cmp rax, 256;
        jb  elcj_rx_success;
        // APR-journal failure -- pass the ELVJ_ERR_APR_JOURNAL_FAIL /
        // ELVJ_ERR_BAD_ACTOR back to the caller.
        jmp elcj_rx_out;

      elcj_rx_success:
        xor rax, rax;                    // ELVC_OK

      elcj_rx_out:
        add rsp, 8;
        pop rbp;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret
      }
    }
}
