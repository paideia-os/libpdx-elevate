// src/elevate_client.pdx -- libpdx-elevate.M1-002 (paideia-os/libpdx-elevate#2)
//
// svc.elevate-broker binding + block-on-reply skeleton.
//
// =============================================================================
// SCOPE
// =============================================================================
//
// The client half of the R48.M7 elevate protocol:
//
//   * Canonical name binding for svc.elevate-broker (mirror of the
//     paideia-os ElevateBroker.elevate_broker_name constant at
//     src/kernel/core/ipc/elevate_broker.pdx:50) so a client library
//     user does not need to spell the string themselves and cannot
//     accidentally register under a shifted name.
//   * elevate_client_lookup_broker() -- wraps svc_lookup with the
//     canonical (name_ptr, name_len) pair.  Returns the u16 endpoint_id
//     (zero-extended to u64) on hit or SVC_LOOKUP_NONE on miss.
//   * elevate_client_request_norealize(caps, dur, req_buf, reply_buf) --
//     the M1 block-on-reply SKELETON, RENAMED at libpdx-elevate.ENH-005
//     (#12) from `elevate_client_request`: assemble the REQ frame into
//     req_buf (via elevate_request_write_frame), resolve the broker
//     via elevate_client_lookup_broker, and return
//     ELVC_NOT_DISPATCHED.  It never sends, never receives, never
//     validates a grant -- see WHY THE RENAME below.  The actual
//     endpoint_invoke + block-on-recv live at
//     elevate_client_request_ex (elevate_client_send.pdx, M2) and the
//     grant-handle composition elevate_client_acquire
//     (elevate_client_acquire.pdx, ENH-001).
//   * _elevate_client_stats -- eight-word counter table so the client's
//     own health is observable independently of the broker's stats.
//     Same shape as ElevateBroker._elevate_broker_stats.
//
// =============================================================================
// WHY THE RENAME (ENH-005, #12) -- retiring "ELVC_STUB means proceed"
// =============================================================================
//
// The post-1.0.0 enhancement audit (.plans/enhancement-plan.md §2) found
// that `elevate_client_request` -- the name every real caller reached
// for, because it was the only entry point that fit in four arguments
// and needed no reply endpoint -- NEVER dispatches.  Two consumers
// called the identical function and reached OPPOSITE security
// dispositions from its return value: one treated the STUB sentinel as
// "proceed" (fail-open), the other treated it as "refuse" (fail-
// closed).  That is a library-side API defect: a sentinel that lives in
// the error/status band but reads, in this library's OWN README
// example, as a second spelling of "proceed" is a coin-flip for every
// future consumer.
//
// The fix has two parts, both landed here:
//
//   (1) RENAME.  `elevate_client_request` no longer exists under that
//       name.  Any caller still linking against it fails at BUILD time
//       -- a compile error, not a silent security bug -- and is forced
//       to make an explicit choice: either it truly cannot dispatch
//       (rare; the new name says so) and should call
//       elevate_client_request_norealize with the SAME semantics as
//       before, or -- the overwhelmingly likely case for any caller
//       gating a mutating operation -- it wants a flow that actually
//       reaches the broker, and should migrate to
//       elevate_client_request_ex (M2, real dispatch) or
//       elevate_client_acquire (ENH-001, dispatch + a grant HANDLE the
//       caller must thread into the privileged op).  This is the one
//       source-breaking change in the v1.1.0 surface; `rm` and `pkg`
//       track their own migration under their own issues.
//   (2) CONSTANT RENAME.  ELVC_STUB is renamed to
//       ELVC_NOT_DISPATCHED (same numeric value, 0xFFFFEA00, so no
//       stats/wire encoding shifts).  "STUB" described the
//       implementation stage (M1); "NOT_DISPATCHED" describes the
//       SECURITY FACT a caller must act on -- this function did not
//       reach the broker, so nothing was authorized.  A name that
//       states the security fact is harder to misread as "proceed"
//       than one that states an implementation milestone.
//
// elevate_client_request_norealize is NOT deprecated for removal: a
// caller that genuinely only wants "assemble + resolve, no wire hop"
// (a dry-run / capability-probe use case) still has a name for that --
// it just can no longer be mistaken for the name real callers reach
// for by default, because that name (elevate_client_request) is gone.
//
// =============================================================================
// ERROR BAND 0xFFFFEA00..0xFFFFEA0F
// =============================================================================
//
//   0xFFFFEA00  ELVC_NOT_DISPATCHED  -- elevate_client_request_norealize's
//                                        ONLY return (validated + resolved,
//                                        never sent).  NEVER a proceed
//                                        signal; see WHY THE RENAME above.
//   0xFFFFEA0B  ELVC_ERR_BAD_BUF     -- req_buf or reply_buf is 0
//   0xFFFFEA0C  ELVC_ERR_RECV_FAIL   -- M2+: block-on-reply gave up
//   0xFFFFEA0D  ELVC_ERR_SEND_FAIL   -- M2+: endpoint_invoke refused
//   0xFFFFEA0E  ELVC_ERR_PACK_FAIL   -- underlying elevate_request pack refused
//   0xFFFFEA0F  ELVC_ERR_LOOKUP_FAIL -- svc.elevate-broker not registered
//
// The band sits above the 0xFFFFE5E* wire-error band (ELV_ERR_*) so a
// caller can inspect a single return value and tell "the request could
// not be built" (ELV_ERR_*) from "the request could not be delivered"
// (ELVC_ERR_*) without knowing the internal call graph.  Only ELVC_OK
// (0, defined below) means an operation was actually authorized end to
// end; every other value in this file -- including
// ELVC_NOT_DISPATCHED -- is a refuse/no-op signal.

module ElevateClient = structure {

  // ---- Canonical name -- mirror of paideia-os ElevateBroker.elevate_broker_name ----
  //
  // 20 bytes = "svc.elevate-broker" (18) + NUL + pad.  The pad exists so
  // the constant is a whole multiple of 4 bytes (the assembler prefers
  // this for .rodata placement) and so a future rename to a slightly
  // longer name does not immediately have to grow the buffer.
  pub let elevate_broker_name : [u8; 20] = "svc.elevate-broker\0\0"
  pub let ELEVATE_BROKER_NAME_LEN : u64 = 18   // strlen("svc.elevate-broker")

  // ---- Result codes ----

  pub let ELVC_OK                : u64 = 0
  pub let ELVC_NOT_DISPATCHED    : u64 = 0xFFFFEA00
  pub let ELVC_ERR_BAD_BUF       : u64 = 0xFFFFEA0B
  pub let ELVC_ERR_RECV_FAIL     : u64 = 0xFFFFEA0C
  pub let ELVC_ERR_SEND_FAIL     : u64 = 0xFFFFEA0D
  pub let ELVC_ERR_PACK_FAIL     : u64 = 0xFFFFEA0E
  pub let ELVC_ERR_LOOKUP_FAIL   : u64 = 0xFFFFEA0F

  // ---- Sentinel mirrored from paideia-os SvcBroker.SVC_LOOKUP_NONE ----

  pub let SVC_LOOKUP_NONE : u64 = 0xFFFFFFFFFFFFFFFF

  // ---- Client-side stats table ----
  //
  // Same shape as ElevateBroker._elevate_broker_stats: eight u64 slots,
  // cache-line aligned, bounded increment via elevate_client_note,
  // bounded read via elevate_client_stat.  Slots:
  //
  //   0 ELVC_ST_LOOKUPS   svc_lookup calls that returned a live id
  //   1 ELVC_ST_REQUESTS  REQ frames successfully assembled
  //   2 ELVC_ST_REPLIES   APR frames successfully received (M2+)
  //   3 ELVC_ST_ERRORS    any error path taken
  //   4 ELVC_ST_STUBS     M1 happy path (validated + resolved, no dispatch)
  //   5..7 reserved       for M2/M3 (auto-approve hits, human timeouts,
  //                       journal write failures)

  pub let mut _elevate_client_stats : [u64; 8] = uninit @align(64)

  pub let ELVC_ST_LOOKUPS  : u64 = 0
  pub let ELVC_ST_REQUESTS : u64 = 1
  pub let ELVC_ST_REPLIES  : u64 = 2
  pub let ELVC_ST_ERRORS   : u64 = 3
  pub let ELVC_ST_STUBS    : u64 = 4
  pub let ELVC_ST_MAX      : u64 = 8

  pub let elevate_client_stats_reset : () -> () !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-elevate.M1-002 (#2): clear the eight-word client counter table. Startup + teardown only (a live counter reset would race any concurrent elevate_client_note). Same shape as elevate_broker_stats_reset at src/kernel/core/ipc/elevate_broker.pdx:70. Labels prefixed elc_rs_.",
      block: {
        lea r10, [rip + _elevate_client_stats];
        xor rax, rax;
        xor rcx, rcx;
      elc_rs_loop:
        mov [r10 + rcx * 8], rax;
        add rcx, 1;
        cmp rcx, 8;
        jb  elc_rs_loop;
        ret
      }
    }

  pub let elevate_client_note : (u64) -> () !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-elevate.M1-002 (#2): bounded increment; out-of-range which is a no-op (not an error) so a caller passing a slot from a newer library version against an older linker snapshot cannot corrupt live counters. Same shape as elevate_broker_note. Labels prefixed elc_nt_.",
      block: {
        cmp rdi, 8;
        jae elc_nt_out;
        lea r10, [rip + _elevate_client_stats];
        mov rax, [r10 + rdi * 8];
        add rax, 1;
        mov [r10 + rdi * 8], rax;
      elc_nt_out:
        ret
      }
    }

  pub let elevate_client_stat : (u64) -> u64 !{mem} @{} =
    fn (which: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-elevate.M1-002 (#2): bounded read; out-of-range which returns 0 (not an error sentinel -- a slot's count IS zero if it has never been incremented, so 0 is the correct answer for both 'never touched' and 'out of range'). Same shape as elevate_broker_stat. Labels prefixed elc_st_.",
      block: {
        cmp rdi, 8;
        jae elc_st_zero;
        lea r10, [rip + _elevate_client_stats];
        mov rax, [r10 + rdi * 8];
        ret;
      elc_st_zero:
        xor rax, rax;
        ret
      }
    }

  // ==========================================================================
  // elevate_client_lookup_broker() -> endpoint_id | SVC_LOOKUP_NONE
  //
  // Resolve the canonical "svc.elevate-broker" name to its endpoint_id
  // via the R20b service registry (svc_lookup at
  // src/kernel/core/ipc/svc_broker.pdx:281).
  //
  // Returns:
  //   endpoint_id      u16 zero-extended to u64 (valid range [0..127])
  //   SVC_LOOKUP_NONE  0xFFFFFFFFFFFFFFFF -- the broker is not registered
  //                    (elevate_broker_register at R48b substrate-prep
  //                    has not yet been called at boot, or the entry was
  //                    displaced by a future unregister path)
  //
  // Bumps ELVC_ST_LOOKUPS on the OK path; ELVC_ST_ERRORS on miss.
  // ==========================================================================

  pub let elevate_client_lookup_broker : () -> u64 !{mem} @{} =
    fn () -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-elevate.M1-002 (#2): call svc_lookup with the canonical (name_ptr, name_len) pair. One callee-save push (r12 = raw svc_lookup return, so the miss discriminator has a stable operand across the elevate_client_note call) + sub rsp, 8 aligns the stack for the nested calls. SVC_LOOKUP_NONE (0xFFFFFFFFFFFFFFFF) exceeds imm32 so it is staged in r10 for the compare. Labels prefixed elc_lb_.",
      block: {
        push r12;
        sub rsp, 8;                      // align

        lea rdi, [rip + elevate_broker_name];
        mov rsi, 18;                     // ELEVATE_BROKER_NAME_LEN
        call svc_lookup;
        mov r12, rax;

        mov r10, 0xFFFFFFFFFFFFFFFF;     // SVC_LOOKUP_NONE
        cmp r12, r10;
        je  elc_lb_miss;

        // Hit -- bump ELVC_ST_LOOKUPS.
        mov rdi, 0;                      // ELVC_ST_LOOKUPS
        call elevate_client_note;
        mov rax, r12;
        add rsp, 8;
        pop r12;
        ret;

      elc_lb_miss:
        // Miss -- bump ELVC_ST_ERRORS and return the sentinel.
        mov rdi, 3;                      // ELVC_ST_ERRORS
        call elevate_client_note;
        mov r10, 0xFFFFFFFFFFFFFFFF;
        mov rax, r10;
        add rsp, 8;
        pop r12;
        ret
      }
    }

  // ==========================================================================
  // elevate_client_request_norealize(caps, dur, req_buf, reply_buf) -> ELVC_*
  //
  // RENAMED at libpdx-elevate.ENH-005 (#12) from `elevate_client_request`
  // -- see WHY THE RENAME in the file header.  Behavior is BYTE-FOR-BYTE
  // unchanged from the M1 skeleton; only the name (and the STUB
  // constant's name) changed, so the security fact is legible from the
  // call site: this function never realizes (dispatches) the request.
  //
  // Sequence:
  //
  //   (1) Gate req_buf != 0 AND reply_buf != 0 -> ELVC_ERR_BAD_BUF.
  //   (2) elevate_request_write_frame(req_buf, caps, dur) -- assemble
  //       the REQ frame into caller-provided scratch.  Any pack error
  //       propagates as ELVC_ERR_PACK_FAIL (the specific ELV_ERR_* is
  //       observable in the caller's own error path via a second call
  //       to the packer if they need the sub-classification -- keeping
  //       the client return band flat).
  //   (3) elevate_client_lookup_broker() -- resolve svc.elevate-broker
  //       to an endpoint id.  Miss -> ELVC_ERR_LOOKUP_FAIL.
  //   (4) Stop: return ELVC_NOT_DISPATCHED.  This function NEVER sends,
  //       NEVER receives, NEVER validates a grant -- do not gate a
  //       privileged operation on its return.  Use
  //       elevate_client_request_ex (elevate_client_send.pdx) or
  //       elevate_client_acquire (elevate_client_acquire.pdx) for a
  //       flow that actually reaches the broker.
  //
  // reply_buf is validated non-null (see (1)) but not touched beyond
  // that, so a caller migrating to a real-dispatch entry point does not
  // need to change their call site to pass an additional buffer.
  //
  // Register plan:
  //   r12 = caps         (saved across nested calls)
  //   r13 = dur
  //   r14 = req_buf
  //   r15 = reply_buf    (gate-only; never dereferenced)
  // Four callee-save pushes = 32 bytes; entry rsp%16==8 -> after four
  // pushes rsp%16==8 (still misaligned).  One 8-byte alignment pad
  // brings rsp%16==0 across every nested call (write_frame,
  // lookup_broker, client_note) -- the same shape every other 4-push
  // wrapper in this library uses (elevate_client_send_req L326-330).
  // v1.1.2 fix per LE.M1-polish #40 (G1).
  // ==========================================================================

  pub let elevate_client_request_norealize : (u64, u64, u64, u64) -> u64 !{mem} @{} =
    fn (caps: u64) (dur: u64) (req_buf: u64) (reply_buf: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-elevate.ENH-005 (#12) with v1.1.2 alignment fix (#40, LE.M1-polish G1): renamed from elevate_client_request (M1-002, #2) -- see the file header WHY THE RENAME note. Four callee-save pushes (r12=caps, r13=dur, r14=req_buf, r15=reply_buf) preserve the args across three nested calls (elevate_request_write_frame, elevate_client_lookup_broker, elevate_client_note). Entry rsp%16==8; four pushes leave rsp%16==8 (still misaligned), so a single 8-byte alignment pad brings rsp%16==0 across every nested call -- matching the 4-push shape elsewhere in this library (elevate_client_send_req L326-330). Every exit path unwinds the pad before popping. Each error path bumps ELVC_ST_ERRORS before returning so the client's own stats table records the failure without needing the caller to touch the journal. The reply_buf gate refuses a 0 pointer up-front; this function does not touch reply_buf beyond the gate and NEVER dispatches -- ELVC_NOT_DISPATCHED is its only non-error return and must never be read as authorization. SVC_LOOKUP_NONE (0xFFFFFFFFFFFFFFFF) is staged in r10 for the miss compare. Labels prefixed elc_rq_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;
        sub rsp, 8;                      // alignment pad (see justification)

        mov r12, rdi;                    // caps
        mov r13, rsi;                    // dur
        mov r14, rdx;                    // req_buf
        mov r15, rcx;                    // reply_buf

        cmp r14, 0;
        je  elc_rq_bad_buf;
        cmp r15, 0;
        je  elc_rq_bad_buf;

        // (2) Assemble REQ frame into req_buf.
        mov rdi, r14;
        mov rsi, r12;
        mov rdx, r13;
        call elevate_request_write_frame;
        cmp rax, 0;
        jne elc_rq_pack_fail;

        // Frame assembled -- bump ELVC_ST_REQUESTS.
        mov rdi, 1;                      // ELVC_ST_REQUESTS
        call elevate_client_note;

        // (3) Resolve broker endpoint.
        call elevate_client_lookup_broker;
        mov r10, 0xFFFFFFFFFFFFFFFF;     // SVC_LOOKUP_NONE
        cmp rax, r10;
        je  elc_rq_lookup_fail;

        // (4) Stop -- endpoint resolved; NEVER dispatched.
        mov rdi, 4;                      // ELVC_ST_STUBS
        call elevate_client_note;
        mov rax, 0xFFFFEA00;             // ELVC_NOT_DISPATCHED
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;

      elc_rq_pack_fail:
        mov rdi, 3;                      // ELVC_ST_ERRORS
        call elevate_client_note;
        mov rax, 0xFFFFEA0E;             // ELVC_ERR_PACK_FAIL
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;

      elc_rq_lookup_fail:
        mov rdi, 3;                      // ELVC_ST_ERRORS
        call elevate_client_note;
        mov rax, 0xFFFFEA0F;             // ELVC_ERR_LOOKUP_FAIL
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;

      elc_rq_bad_buf:
        mov rdi, 3;                      // ELVC_ST_ERRORS
        call elevate_client_note;
        mov rax, 0xFFFFEA0B;             // ELVC_ERR_BAD_BUF
        add rsp, 8;
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret
      }
    }
}
